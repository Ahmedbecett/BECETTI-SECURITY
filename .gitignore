# Build outputs
[Bb]in/
[Oo]bj/
*.user
*.suo
TestResults/

# Windows / MSIX
*.msix
*.msixbundle
*.appx
*.appxbundle
*.pfx
*.snk
AppPackages/
BundleArtifacts/

# Store submission artifacts (large, binary, reproducible from CI; the
# checksum is recorded in the release/submission docs instead of the file)
artifacts/store/

# IDE
.vs/
.idea/
*.DotSettings.user

# OS
.DS_Store
Thumbs.db

# Secrets / local config (never commit)
appsettings.Development.json
appsettings.Production.json
.env

# Locally generated signing material handed to the repo owner to add as
# GitHub Actions secrets - must never be committed, even the "public" .cer
# copy (keep it paired with its password file instead of scattered in git
# history).
local-only/
*.pfx

# Logs
*.log
logs/

# Python
__pycache__/
*.pyc
*.pyo

# Native YARA binaries built by scripts/build-yara-win64.ps1 (reproduced in CI)
src/Becetti.Security.App/Native/yara/win-x64/*.exe
src/Becetti.Security.App/Native/yara/win-x64/yara-build-info.json
src/Becetti.Security.App/Native/yara/win-x64/COPYING

# MG Ads runtime payload generated by scripts/build-mgads-host.ps1.
# The official SDK binaries live in src/Becetti.Security.MgAdsHost/SDK and
# are committed; the built host + generated credentials are not.
src/Becetti.Security.App/MgAdsHost/
