# Secrets / local config (never commit)
appsettings.Development.json
appsettings.Production.json
.env

# Locally generated signing material handed to the repo owner to add as
# GitHub Actions secrets - must never be committed, even the "public" .cer
# copy (keep it paired with its password file instead of scattered in git
# history).
local-only/
*.pfx

# Logs
*.log
logs/

# Python
__pycache__/
*.pyc
*.pyo

# Native YARA binaries built by scripts/build-yara-win64.ps1 (reproduced in CI)
src/Becetti.Security.App/Native/yara/win-x64/*.exe
src/Becetti.Security.App/Native/yara/win-x64/yara-build-info.json
src/Becetti.Security.App/Native/yara/win-x64/COPYING

# Store listing artwork pipeline (scripts/store-art.py)
# The committed PNGs in store/art/ are the deliverables; these are scratch.
.venv-art/
.art-cache/
