<Page
    x:Class="Becetti.Security.App.Views.GlobalIntelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Becetti.Security.Core.Models"
    xmlns:helpers="using:Becetti.Security.App.Helpers"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid Padding="28,24,28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Uid="GlobalIntelPageTitle" helpers:Loc.Uid="GlobalIntelPageTitle"
                           Text="Global Threat Feeds, GeoIP Radar &amp; Privacy"
                           Style="{StaticResource PageTitleStyle}"/>
                <TextBlock x:Uid="GlobalIntelPageSubtitle" helpers:Loc.Uid="GlobalIntelPageSubtitle"
                           Text="Live abuse.ch C2/Malware IOC feeds, outbound GeoIP connection radar, MITRE ATT&amp;CK Enterprise matrix, Windows anti-telemetry hardener &amp; GitHub Releases auto-updater."
                           Style="{StaticResource SectionSubtitleStyle}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ProgressRing IsActive="{Binding IsBusy}" Width="22" Height="22"/>
                <Button Content="Sync Global Feeds" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SyncFeedsCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Status / Error -->
        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar IsOpen="{Binding HasStatus}" Severity="Informational" Title="Status" Message="{Binding StatusMessage}"/>
            <InfoBar IsOpen="{Binding HasError}" Severity="Error" Title="Alert" Message="{Binding ErrorMessage}"/>
        </StackPanel>

        <Pivot Grid.Row="2">

            <!-- Tab 1: abuse.ch Global Open Threat Feeds (#2) -->
            <PivotItem x:Uid="GlobalTabFeeds" helpers:Loc.Uid="GlobalTabFeeds" Header="Global Threat Feeds">
                <ScrollViewer Padding="0,12,0,12">
                    <StackPanel Spacing="16">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="abuse.ch Open Threat Intelligence Feeds (Feodo C2 · URLhaus · MalwareBazaar)" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding FeedSummary}" Foreground="{StaticResource ElectricBlueBrush}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Sync Live abuse.ch Feeds" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SyncFeedsCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Instant Local IOC Lookup (IP · Domain · URL · SHA-256)" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox PlaceholderText="Enter IP address, domain, URL, or 64-char SHA-256 hash..."
                                             Text="{Binding IocLookupInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1" Content="Check IOC" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding LookupIocCommand}"/>
                                </Grid>
                                <TextBlock Text="{Binding IocLookupResult}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- Tab 2: Live Outbound GeoIP Radar & 1-Click Firewall Blocker (#3) -->
            <PivotItem x:Uid="GlobalTabRadar" helpers:Loc.Uid="GlobalTabRadar" Header="Live GeoIP Radar">
                <ScrollViewer Padding="0,12,0,12">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding RadarSummary}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Content="Scan Live Connections" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ScanRadarCommand}"/>
                                    <Button Content="Block App in Firewall" Background="{StaticResource DangerBrush}" Foreground="White" Command="{Binding BlockSelectedConnectionCommand}"/>
                                    <Button Content="Ask BECETTI AI" Command="{Binding AskAiConnectionCommand}"/>
                                </StackPanel>
                            </Grid>
                            <ListView ItemsSource="{Binding OutboundConnections}" SelectedItem="{Binding SelectedConnection, Mode=TwoWay}" MaxHeight="440">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:OutboundConnectionIntel">
                                        <StackPanel Padding="6,8" Spacing="3">
                                            <TextBlock Text="{x:Bind DisplayLine}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{x:Bind DetailLine}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </PivotItem>

            <!-- Tab 3: MITRE ATT&CK Enterprise Coverage Matrix (#1) -->
            <PivotItem x:Uid="GlobalTabMitre" helpers:Loc.Uid="GlobalTabMitre" Header="MITRE ATT&amp;CK">
                <ScrollViewer Padding="0,12,0,12">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="MITRE ATT&amp;CK Enterprise Detection Coverage" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Every BECETTI SECURITY EDR, Persistence, PowerShell/LOLBins, DLL Injection, ARP Spoofing, Ransomware Canary, and Threat Feed finding maps to official MITRE ATT&amp;CK technique IDs." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding MitreTechniques}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:MitreAttackReference">
                                        <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource GlowBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{x:Bind Badge}" FontWeight="SemiBold" Foreground="{StaticResource ElectricBlueBrush}"/>
                                                    <TextBlock Text="{x:Bind Url}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="MITRE Docs" Click="OpenMitreUrl_Click" Tag="{x:Bind Url}" FontSize="12" Padding="10,4" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </PivotItem>

            <!-- Tab 4: Windows Privacy & Anti-Telemetry Hardener (#8) -->
            <PivotItem x:Uid="GlobalTabPrivacy" helpers:Loc.Uid="GlobalTabPrivacy" Header="Privacy Hardener">
                <ScrollViewer Padding="0,12,0,12">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding PrivacyScoreText}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource ElectricBlueBrush}" Margin="0,0,18,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Windows Privacy &amp; Anti-Telemetry Hardener" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding PrivacySummary}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="Audit Privacy" Command="{Binding AuditPrivacyCommand}"/>
                                    <Button Content="Harden All Recommended" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding HardenAllPrivacyCommand}"/>
                                </StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding PrivacyControls}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:PrivacyControlItem">
                                        <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource GlowBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{x:Bind DisplayLine}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{x:Bind RegistryLocation}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextMutedBrush}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="{x:Bind ToggleButtonLabel}" Click="TogglePrivacyControl_Click" Tag="{x:Bind}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </PivotItem>

            <!-- Tab 5: In-App Auto-Updater via GitHub Releases (#6) -->
            <PivotItem x:Uid="GlobalTabUpdater" helpers:Loc.Uid="GlobalTabUpdater" Header="App Auto-Updater">
                <ScrollViewer Padding="0,12,0,12">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="BECETTI SECURITY Official Releases Auto-Updater" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding UpdaterCurrentVersion}" FontWeight="SemiBold" Foreground="{StaticResource ElectricBlueBrush}"/>
                            <TextBlock Text="{Binding UpdaterSummary}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="Check Official GitHub Releases" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CheckUpdatesCommand}"/>
                                <Button Content="Download Signed MSIX Update" Command="{Binding DownloadUpdateCommand}"/>
                            </StackPanel>
                            <TextBox IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140"
                                     Text="{Binding UpdaterNotes}" PlaceholderText="Release changelog and signed MSIX asset details appear here..."/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </PivotItem>

        </Pivot>
    </Grid>
</Page>
