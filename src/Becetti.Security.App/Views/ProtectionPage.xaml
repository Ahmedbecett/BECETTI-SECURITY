<Page
    x:Class="Becetti.Security.App.Views.ProtectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer Background="{StaticResource AppBackgroundBrush}">
        <StackPanel Padding="32" MaxWidth="900">
            <TextBlock x:Uid="TitleProtection" Text="Real-Time Protection" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Uid="SubtitleProtection" Text="Verified Microsoft Defender state. Changes are applied through Defender and re-verified before success is reported." Style="{StaticResource SectionSubtitleStyle}" TextWrapping="Wrap" />
            <InfoBar Title="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Margin="0,0,0,16" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="32" Height="32" Margin="0,0,0,16" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Current State (verified)" Style="{StaticResource ValueStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,8" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.SignatureText, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Protection Features (verified)" Style="{StaticResource ValueStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.CloudProtectionText, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.SampleSubmissionText, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.BehaviorMonitorText, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.NetworkProtectionText, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="Cloud-delivered protection and automatic sample submission are read from Get-MpPreference. BECETTI SECURITY does not change these settings directly — use Windows Security below for that." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Real-Time Monitoring" Style="{StaticResource ValueStyle}" />
                    <TextBlock Text="Requires administrator rights. If the change is blocked by policy or tamper protection, the real state is shown above." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Enable Real-Time Protection" Command="{x:Bind ViewModel.EnableRealTimeCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Content="Disable Real-Time Protection" Command="{x:Bind ViewModel.DisableRealTimeCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Security Intelligence Updates" Style="{StaticResource ValueStyle}" />
                    <TextBlock Text="Downloads the latest Defender signatures (Update-MpSignature). Requires administrator rights." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12" TextWrapping="Wrap" />
                    <Button Content="Update Signatures Now" Command="{x:Bind ViewModel.UpdateSignaturesCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Administrator Rights" Style="{StaticResource ValueStyle}" />
                    <TextBlock Text="Some actions need elevation. Restarting as administrator opens a UAC prompt." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12" TextWrapping="Wrap" />
                    <Button Content="Restart as Administrator" Command="{x:Bind ViewModel.RestartElevatedCommand}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="More Protection Settings" Style="{StaticResource ValueStyle}" />
                    <TextBlock Text="Exclusions, ransomware protection and other detailed settings are managed in Windows Security itself, not duplicated here." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12" TextWrapping="Wrap" />
                    <Button Content="Open Windows Security" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" />
                </StackPanel>
            </Border>
            <Button Content="Refresh Status" Command="{x:Bind ViewModel.RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
