<Page
    x:Class="Becetti.Security.App.Views.SecureVaultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Becetti.Security.Core.Models"
    xmlns:converters="using:Becetti.Security.App.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <ScrollViewer Background="{StaticResource AppBackgroundBrush}">
        <StackPanel Padding="32" MaxWidth="900">
            <TextBlock x:Uid="TitleSecureVault" Text="Secure Vault" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Uid="SubtitleSecureVault"
                       Text="A local, encrypted (AES-256) storage area for files you choose to protect. The encryption key is bound to your Windows account on this device with DPAPI — nothing here is ever uploaded anywhere."
                       Style="{StaticResource SectionSubtitleStyle}" TextWrapping="Wrap" />

            <InfoBar Title="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Margin="0,0,0,16" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="32" Height="32" Margin="0,0,0,16" />

            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsInitialized, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <StackPanel>
                    <TextBlock x:Uid="SecureVaultNotCreatedLabel" Text="No vault exists on this device yet." Style="{StaticResource ValueStyle}" />
                    <Button x:Uid="SecureVaultCreateButton" Content="Create vault" Command="{x:Bind ViewModel.InitializeVaultCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsInitialized, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock x:Uid="SecureVaultAddLabel" Text="Add a file" Style="{StaticResource ValueStyle}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{x:Bind ViewModel.PendingFilePath, Mode=OneWay}" IsReadOnly="True" Margin="0,0,8,0" />
                        <Button x:Uid="SecureVaultBrowseButton" Grid.Column="1" Content="Browse" Click="BrowseButton_Click" />
                    </Grid>
                    <CheckBox x:Uid="SecureVaultShredOriginalCheckBox" Content="Securely delete the original file after encrypting it"
                              IsChecked="{x:Bind ViewModel.ShredOriginalAfterAdd, Mode=TwoWay}" Margin="0,8,0,0" />
                    <Button x:Uid="SecureVaultAddButton" Content="Add to vault" Command="{x:Bind ViewModel.AddFileCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsInitialized, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock x:Uid="SecureVaultItemsLabel" Text="Files in the vault" Style="{StaticResource ValueStyle}" />
                    <ListView ItemsSource="{x:Bind ViewModel.Items}" SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}" MinHeight="160" Margin="0,8,0,0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:VaultItemInfo">
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Bind OriginalFileName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind SizeLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Uid="SecureVaultExtractButton" Content="Extract" Margin="8,0" Click="ExtractButton_Click" Tag="{x:Bind}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button x:Uid="SecureVaultDeleteButton" Content="Remove selected" Command="{x:Bind ViewModel.DeleteSelectedCommand}"
                            IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
