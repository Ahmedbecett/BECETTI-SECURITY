<Page
    x:Class="Becetti.Security.App.Views.ContactPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer Background="{StaticResource AppBackgroundBrush}">
        <StackPanel Padding="32" MaxWidth="900">
            <TextBlock x:Uid="TitleContact" Text="Contact Becetti" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Uid="SubtitleContact"
                       Text="Nothing is sent automatically. This prepares a draft in your own email app — you review and press Send yourself."
                       Style="{StaticResource SectionSubtitleStyle}" TextWrapping="Wrap" />

            <InfoBar Title="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Margin="0,0,0,16" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="32" Height="32" Margin="0,0,0,16" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="SupportWhatsAppLabel" Text="WhatsApp" Style="{StaticResource ValueStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.SupportWhatsAppDisplay, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,8" />
                    <Button x:Uid="OpenWhatsAppButton" Content="Open WhatsApp" Command="{x:Bind ViewModel.OpenWhatsAppCommand}" Margin="0,0,0,16" />

                    <TextBlock Text="Support address" Style="{StaticResource ValueStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.SupportEmail, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12" />

                    <TextBlock Text="Subject" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{x:Bind ViewModel.Subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="What is this about?" Margin="0,0,0,12" />

                    <TextBlock Text="Message" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{x:Bind ViewModel.Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Describe the issue or question…" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="160" Margin="0,0,0,12" />

                    <ToggleSwitch Header="Include diagnostics (OS version, Defender status) in the draft"
                                  IsOn="{x:Bind ViewModel.IncludeDiagnostics, Mode=TwoWay}" Margin="0,0,0,12" />

                    <Button Content="Prepare Email" Command="{x:Bind ViewModel.PrepareEmailCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Border>

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
