<Page
    x:Class="Becetti.Security.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:Becetti.Security.App.Helpers"
    mc:Ignorable="d">
    <ScrollViewer Background="{StaticResource AppBackgroundBrush}">
        <StackPanel Padding="32" MaxWidth="900">
            <TextBlock x:Uid="TitleAbout" helpers:Loc.Uid="TitleAbout" Text="About BECETTI SECURITY" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Uid="SubtitleAbout" helpers:Loc.Uid="SubtitleAbout" Text="Your Digital Protection Center" Style="{StaticResource SectionSubtitleStyle}" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="32" Height="32" Margin="0,0,0,16" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Version" Style="{StaticResource LabelStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}" Style="{StaticResource ValueStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Build / Device" Style="{StaticResource LabelStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.BuildText, Mode=OneWay}" Style="{StaticResource ValueStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Native YARA Malware Engine" Style="{StaticResource LabelStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.YaraText, Mode=OneWay}" Style="{StaticResource ValueStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Microsoft Defender Integration" Style="{StaticResource LabelStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.DefenderText, Mode=OneWay}" Style="{StaticResource ValueStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="How It Works" Style="{StaticResource ValueStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.CapabilityText, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="YaraLicenseTitle" helpers:Loc.Uid="YaraLicenseTitle" Text="Third-Party Open-Source Licenses (YARA BSD-3-Clause)" Style="{StaticResource ValueStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.YaraLicenseText, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Developed by BECETTI" Style="{StaticResource ValueStyle}" />
                    <TextBlock Text="BECETTI SECURITY v1.0.0 — Windows 10 and Windows 11 (x64). English, العربية, Français." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Button x:Uid="RefreshButton" helpers:Loc.Uid="RefreshButton" Content="Refresh" Command="{x:Bind ViewModel.LoadCommand}" Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </ScrollViewer>
</Page>
