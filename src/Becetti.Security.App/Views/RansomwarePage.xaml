<Page
    x:Class="Becetti.Security.App.Views.RansomwarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Becetti.Security.App.Converters"
    xmlns:helpers="using:Becetti.Security.App.Helpers"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>
    <ScrollViewer Background="{StaticResource AppBackgroundBrush}">
        <StackPanel Padding="32" MaxWidth="900">
            <TextBlock x:Uid="TitleRansomware" helpers:Loc.Uid="TitleRansomware" Text="Ransomware Defense" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Uid="SubtitleRansomware" helpers:Loc.Uid="SubtitleRansomware"
                       Text="Microsoft Defender's own Controlled Folder Access (Exploit Guard). BECETTI SECURITY only reads and explains this real Windows feature — it never runs its own ransomware engine."
                       Style="{StaticResource SectionSubtitleStyle}" TextWrapping="Wrap" />
            <InfoBar Title="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Margin="0,0,0,16" />
            <InfoBar x:Uid="ElevationRequiredInfoBar" helpers:Loc.Uid="ElevationRequiredInfoBar" Title="Administrator required"
                     Message="Changing Controlled Folder Access requires an administrator. Use Settings → Restart as administrator."
                     Severity="Warning" IsOpen="{x:Bind ViewModel.NeedsElevation, Mode=OneWay}" IsClosable="False" Margin="0,0,0,16" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="32" Height="32" Margin="0,0,0,16" />

            <Border Style="{StaticResource GlassHeroCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Controlled Folder Access" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.StateText, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Uid="EnableButton" helpers:Loc.Uid="EnableButton" Content="Enable" Command="{x:Bind ViewModel.EnableCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{x:Bind ViewModel.IsElevated, Mode=OneWay}" />
                        <Button x:Uid="DisableButton" helpers:Loc.Uid="DisableButton" Content="Disable" Command="{x:Bind ViewModel.DisableCommand}"
                                IsEnabled="{x:Bind ViewModel.IsElevated, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="ProtectedFoldersLabel" helpers:Loc.Uid="ProtectedFoldersLabel" Text="Protected folders" Style="{StaticResource LabelStyle}" />
                    <TextBlock Text="No protected folders were reported (or this could not be read)."
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.HasProtectedFolders, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ProtectedFolders, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.HasProtectedFolders, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind Mode=OneTime}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="RansomwareRecommendationLabel" helpers:Loc.Uid="RansomwareRecommendationLabel" Text="Recommendation"
                               Style="{StaticResource LabelStyle}" />
                    <TextBlock x:Uid="RansomwareRecommendationText" helpers:Loc.Uid="RansomwareRecommendationText"
                               Text="Add your most important personal folders (Documents, Pictures, Desktop) to Controlled Folder Access from Windows Security, so ransomware cannot silently encrypt or delete them. Ask BECETTI AI if you're not sure which folders to protect."
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
