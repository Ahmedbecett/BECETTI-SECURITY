<Page
    x:Class="Becetti.Security.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Becetti.Security.App.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:ProtectionLevelToBrushConverter x:Key="LevelToBrushConverter" />
    </Page.Resources>

    <ScrollViewer Background="{StaticResource AppBackgroundBrush}">
        <StackPanel Padding="32" MaxWidth="900">
            <TextBlock x:Uid="TitleDashboard" Text="Dashboard" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Uid="SubtitleDashboard" Text="Verified security status, read live from Windows and Microsoft Defender." Style="{StaticResource SectionSubtitleStyle}" />
            <InfoBar Title="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Margin="0,0,0,16" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="32" Height="32" Margin="0,0,0,16" />

            <!-- Hero: aggregate protection status + robot mascot + Scan Now. Color/text are
                 derived only from the verified DefenderStatus just read — never decorative. -->
            <Border Style="{StaticResource GlassHeroCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon x:Name="HeroShieldIcon" Glyph="&#xE7EF;" FontSize="32"
                                      Foreground="{x:Bind ViewModel.ProtectionLevel, Mode=OneWay, Converter={StaticResource LevelToBrushConverter}}" />
                            <TextBlock Text="{x:Bind ViewModel.ProtectionHeadline, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.ProtectionSubtext, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,16" MaxWidth="480" />
                        <Button x:Uid="ScanNowButton" Content="Scan Now" Style="{StaticResource PrimaryButtonStyle}" Click="ScanNowButton_Click" />
                    </StackPanel>
                    <Image Grid.Column="1" Source="Assets/RobotMascotHero.png" Width="140" Height="140" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Image.RenderTransform>
                            <TranslateTransform x:Name="MascotTransform" Y="0" />
                        </Image.RenderTransform>
                    </Image>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Antivirus" Style="{StaticResource LabelStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.DefenderText, Mode=OneWay}" Style="{StaticResource ValueStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Real-Time Protection" Style="{StaticResource LabelStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.RealTimeText, Mode=OneWay}" Style="{StaticResource ValueStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Firewall" Style="{StaticResource LabelStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.FirewallText, Mode=OneWay}" Style="{StaticResource ValueStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Security Intelligence" Style="{StaticResource LabelStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.SignatureText, Mode=OneWay}" Style="{StaticResource ValueStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Device" Style="{StaticResource LabelStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.DeviceText, Mode=OneWay}" Style="{StaticResource ValueStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Cloud Connection" Style="{StaticResource LabelStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.CloudText, Mode=OneWay}" Style="{StaticResource ValueStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Last Verified Scan" Style="{StaticResource LabelStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.LastScanText, Mode=OneWay}" Style="{StaticResource ValueStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Application Version" Style="{StaticResource LabelStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}" Style="{StaticResource ValueStyle}" />
                </StackPanel>
            </Border>
            <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
