<Page
    x:Class="Becetti.Security.App.Views.InfrastructureCompliancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28,24,28,40" Spacing="18">

            <!-- Header -->
            <Border Style="{StaticResource GlassHeroCardStyle}" Padding="22">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="InfraComp_Header"
                                   Text="Infrastructure, Vault &amp; Compliance"
                                   Style="{StaticResource PageTitleStyle}" />
                        <TextBlock x:Uid="InfraComp_Subtitle"
                                   Text="LAN &amp; Port Auditor · Live DNS Threat Logger · Privacy Traces Cleaner · AES-256-GCM Vault Pro · Cloud Fleet · CIS/NIST Compliance"
                                   Style="{StaticResource SectionSubtitleStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ProgressRing Grid.Column="1"
                                  IsActive="{Binding IsBusy}"
                                  Width="32" Height="32"
                                  VerticalAlignment="Center" />
                </Grid>
            </Border>

            <InfoBar IsOpen="{Binding HasStatus}" Severity="Success" Message="{Binding StatusMessage}" IsClosable="True" />
            <InfoBar IsOpen="{Binding HasError}" Severity="Error" Message="{Binding ErrorMessage}" IsClosable="True" />

            <!-- 6-Tab Infrastructure & Compliance Pivot -->
            <Pivot>
                <!-- TAB 1: #2 LAN Discovery & Local Port Auditor -->
                <PivotItem Header="LAN &amp; Ports">
                    <StackPanel Spacing="14" Padding="0,14,0,0">
                        <Border Style="{StaticResource CardStyle}" Padding="18">
                            <StackPanel Spacing="12">
                                <Button Content="Scan LAN Devices &amp; Open Ports"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ScanLanCommand}" />
                                <TextBlock Text="{Binding LanSummary}" TextWrapping="Wrap" Opacity="0.9" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Discovered LAN Neighbors (Live ARP + DNS)" FontWeight="SemiBold" FontSize="15" />
                                <ListView ItemsSource="{Binding LanDevices}" MaxHeight="230" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayLine}" FontFamily="Consolas" FontSize="12.5" TextWrapping="Wrap" Margin="0,2" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Exposed Local Listening Ports" FontWeight="SemiBold" FontSize="15" />
                                <ListView ItemsSource="{Binding LocalPorts}" MaxHeight="260" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayLine}" FontFamily="Consolas" FontSize="12.5" TextWrapping="Wrap" Margin="0,2" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </PivotItem>

                <!-- TAB 2: #10 Live DNS Threat Logger & Per-App Connections -->
                <PivotItem Header="DNS &amp; App Net">
                    <StackPanel Spacing="14" Padding="0,14,0,0">
                        <Border Style="{StaticResource CardStyle}" Padding="18">
                            <StackPanel Spacing="12">
                                <Button Content="Audit Live DNS Cache &amp; App Connections"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding AuditDnsNetCommand}" />
                                <TextBlock Text="{Binding DnsSummary}" TextWrapping="Wrap" Opacity="0.9" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Windows DNS Cache (Cross-checked vs abuse.ch URLhaus)" FontWeight="SemiBold" FontSize="15" />
                                <ListView ItemsSource="{Binding DnsEntries}" MaxHeight="240" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayLine}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,2" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Per-Application Active Network Footprint" FontWeight="SemiBold" FontSize="15" />
                                <ListView ItemsSource="{Binding AppConnections}" MaxHeight="240" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayLine}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </PivotItem>

                <!-- TAB 3: #3 Deep Privacy & Digital Traces Cleaner -->
                <PivotItem Header="Privacy Cleaner">
                    <StackPanel Spacing="14" Padding="0,14,0,0">
                        <Border Style="{StaticResource CardStyle}" Padding="18">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Scan Digital Traces" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ScanTracesCommand}" />
                                    <Button Content="Clean Selected Traces Now" Command="{Binding CleanSelectedTracesCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding CleanerSummary}" TextWrapping="Wrap" Opacity="0.9" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Padding="16">
                            <ListView ItemsSource="{Binding TraceCategories}" SelectionMode="None" MaxHeight="380">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="4,6" Spacing="2">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding DisplayLine}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.75" Margin="28,0,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </StackPanel>
                </PivotItem>

                <!-- TAB 4: #6 Encrypted File & Folder Vault Pro -->
                <PivotItem Header="Vault Pro">
                    <StackPanel Spacing="14" Padding="0,14,0,0">
                        <Border Style="{StaticResource CardStyle}" Padding="18">
                            <StackPanel Spacing="12">
                                <TextBlock Text="AES-256-GCM + PBKDF2-SHA256 (310,000 Iterations) Vault" FontWeight="SemiBold" FontSize="15" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Pick File…" Click="OnPickVaultFileClick" />
                                    <Button Content="Pick Folder…" Click="OnPickVaultFolderClick" />
                                    <Button Content="Generate Strong 24-Char Password" Command="{Binding GeneratePasswordCommand}" />
                                </StackPanel>
                                <TextBox Header="Selected File or Folder Path" Text="{Binding VaultSourcePath, Mode=TwoWay}" PlaceholderText="Select a file or folder above…" />
                                <TextBox Header="Vault Passphrase (min 8 chars)" Text="{Binding VaultPassphrase, Mode=TwoWay}" PlaceholderText="Enter strong passphrase…" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Encrypt &amp; Seal into Vault Pro" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SealVaultItemCommand}" />
                                    <Button Content="Decrypt Selected Item…" Click="OnUnsealVaultItemClick" />
                                    <Button Content="Delete Selected" Command="{Binding DeleteVaultItemCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding VaultSummary}" TextWrapping="Wrap" Opacity="0.9" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Padding="16">
                            <ListView ItemsSource="{Binding VaultItems}"
                                      SelectedItem="{Binding SelectedVaultItem, Mode=TwoWay}"
                                      MaxHeight="300">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayLine}" FontFamily="Consolas" FontSize="12.5" TextWrapping="Wrap" Margin="0,3" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </StackPanel>
                </PivotItem>

                <!-- TAB 5: #11 Multi-Device Cloud Fleet Dashboard -->
                <PivotItem Header="Cloud Fleet">
                    <StackPanel Spacing="14" Padding="0,14,0,0">
                        <Border Style="{StaticResource CardStyle}" Padding="18">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Refresh Cloud Fleet" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding LoadFleetCommand}" />
                                    <Button Content="Sync This PC Heartbeat" Command="{Binding SyncHeartbeatCommand}" />
                                    <Button Content="Remove Selected Device" Command="{Binding RemoveFleetDeviceCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding FleetSummary}" TextWrapping="Wrap" Opacity="0.9" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Padding="16">
                            <ListView ItemsSource="{Binding FleetDevices}"
                                      SelectedItem="{Binding SelectedFleetDevice, Mode=TwoWay}"
                                      MaxHeight="340">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayLine}" FontSize="13" TextWrapping="Wrap" Margin="0,4" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </StackPanel>
                </PivotItem>

                <!-- TAB 6: #12 CIS / NIST / ISO Compliance Center -->
                <PivotItem Header="Compliance">
                    <StackPanel Spacing="14" Padding="0,14,0,0">
                        <Border Style="{StaticResource CardStyle}" Padding="18">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Content="Run CIS / NIST / ISO Audit" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RunComplianceCommand}" />
                                    <Button Content="Export HTML Report" Command="{Binding ExportComplianceHtmlCommand}" />
                                    <Button Content="Export JSON Report" Command="{Binding ExportComplianceJsonCommand}" />
                                    <TextBlock Text="{Binding ComplianceScoreText}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding ComplianceSummary}" TextWrapping="Wrap" Opacity="0.9" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Padding="16">
                            <ListView ItemsSource="{Binding ComplianceControls}" SelectionMode="None" MaxHeight="380">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="4,6" Spacing="2">
                                            <TextBlock Text="{Binding DisplayLine}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Remediation}" FontSize="12" Opacity="0.78" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </StackPanel>
                </PivotItem>
            </Pivot>
        </StackPanel>
    </ScrollViewer>
</Page>
