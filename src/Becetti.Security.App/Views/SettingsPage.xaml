<Page
    x:Class="Becetti.Security.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:Becetti.Security.App.Helpers"
    mc:Ignorable="d">
    <ScrollViewer Background="{StaticResource AppBackgroundBrush}">
        <StackPanel Padding="32" MaxWidth="900">
            <TextBlock x:Uid="TitleSettings" helpers:Loc.Uid="TitleSettings" Text="Settings" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Uid="SubtitleSettings" helpers:Loc.Uid="SubtitleSettings" Text="Every setting here is stored and applied. Nothing is decorative." Style="{StaticResource SectionSubtitleStyle}" TextWrapping="Wrap" />
            <InfoBar Title="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Margin="0,0,0,16" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="32" Height="32" Margin="0,0,0,16" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="SettingsLanguageTitle" helpers:Loc.Uid="SettingsLanguageTitle" Text="Language / اللغة / Langue" Style="{StaticResource ValueStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                        <RadioButton Content="English" GroupName="Language" IsChecked="{x:Bind ViewModel.IsEnglish, Mode=TwoWay}" />
                        <RadioButton Content="العربية (Arabic)" GroupName="Language" IsChecked="{x:Bind ViewModel.IsArabic, Mode=TwoWay}" />
                        <RadioButton Content="Français (French)" GroupName="Language" IsChecked="{x:Bind ViewModel.IsFrench, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock x:Uid="SettingsLanguageHint" helpers:Loc.Uid="SettingsLanguageHint" Text="Language changes apply immediately across BECETTI SECURITY and are saved automatically." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="SettingsCloudApiTitle" helpers:Loc.Uid="SettingsCloudApiTitle" Text="Cloud API URL" Style="{StaticResource ValueStyle}" />
                    <TextBlock x:Uid="SettingsCloudApiHint" helpers:Loc.Uid="SettingsCloudApiHint" Text="Leave empty to disable cloud features. The app never invents cloud data." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12" TextWrapping="Wrap" />
                    <TextBox Text="{x:Bind ViewModel.ApiBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="https://api.becetti.security" Margin="0,0,0,12" />
                    <TextBlock Text="{x:Bind ViewModel.ConnectionText, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="SettingsTelemetryTitle" helpers:Loc.Uid="SettingsTelemetryTitle" Text="Telemetry" Style="{StaticResource ValueStyle}" />
                    <TextBlock x:Uid="SettingsTelemetryHint" helpers:Loc.Uid="SettingsTelemetryHint" Text="Off by default. BECETTI SECURITY collects no telemetry unless you opt in here." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12" TextWrapping="Wrap" />
                    <ToggleSwitch x:Uid="SettingsTelemetryToggle" helpers:Loc.Uid="SettingsTelemetryToggle" Header="Allow telemetry" IsOn="{x:Bind ViewModel.TelemetryOptIn, Mode=TwoWay}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="SettingsFeedbackTitle" helpers:Loc.Uid="SettingsFeedbackTitle" Text="Feedback" Style="{StaticResource ValueStyle}" />
                    <TextBlock x:Uid="SettingsFeedbackHint" helpers:Loc.Uid="SettingsFeedbackHint" Text="Animations are purely decorative and never used to imply a scan or update is running. Sounds play only on genuine completed/failed actions." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12" TextWrapping="Wrap" />
                    <ToggleSwitch x:Uid="SettingsAnimations" helpers:Loc.Uid="SettingsAnimations" Header="Enable decorative animations" IsOn="{x:Bind ViewModel.EnableAnimations, Mode=TwoWay}" />
                    <ToggleSwitch x:Uid="SettingsSounds" helpers:Loc.Uid="SettingsSounds" Header="Enable sound cues" IsOn="{x:Bind ViewModel.EnableSounds, Mode=TwoWay}" />
                    <ToggleSwitch x:Uid="SettingsMinimizeToTray" helpers:Loc.Uid="SettingsMinimizeToTray" Header="Keep running silently in Windows System Tray when window is closed" IsOn="{x:Bind ViewModel.MinimizeToTrayOnClose, Mode=TwoWay}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="SettingsAppLockTitle" helpers:Loc.Uid="SettingsAppLockTitle" Text="Anti-Tamper Protection (Windows Hello / PIN Lock)" Style="{StaticResource ValueStyle}" />
                    <TextBlock x:Uid="SettingsAppLockHint" helpers:Loc.Uid="SettingsAppLockHint" Text="Require Windows Hello biometric/PIN verification (or a local PBKDF2-SHA256 PIN) before opening Settings, Emergency Kill-Switch, or Quarantine Vault." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <ToggleSwitch x:Uid="SettingsAppLockToggle" helpers:Loc.Uid="SettingsAppLockToggle" Header="Require authentication for sensitive security controls" IsOn="{x:Bind ViewModel.AppLockEnabled, Mode=TwoWay}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox Grid.Column="0" x:Name="AppLockPinBox" PlaceholderText="Set local fallback Security PIN (4-32 chars)..." PasswordChanged="AppLockPinBox_PasswordChanged" />
                        <Button Grid.Column="1" Content="Set PIN &amp; Enable" Style="{StaticResource PrimaryButtonStyle}" Command="{x:Bind ViewModel.SaveAppLockPinCommand}" />
                        <Button Grid.Column="2" Content="Disable Lock" Command="{x:Bind ViewModel.DisableAppLockCommand}" />
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.AppLockStatusText, Mode=OneWay}" Foreground="{StaticResource ElectricBlueBrush}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="BECETTI AI" Style="{StaticResource ValueStyle}" />
                    <TextBlock x:Uid="SettingsAiHint" helpers:Loc.Uid="SettingsAiHint" Text="The AI assistant talks only to the BECETTI AI server below — the real AI provider key is never stored in this app. Device-state sharing and chat history are separate, off-by-default opt-ins available on the BECETTI AI page."
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12" TextWrapping="Wrap" />
                    <TextBox x:Uid="SettingsAiApiBaseUrl" helpers:Loc.Uid="SettingsAiApiBaseUrl" Header="BECETTI AI server URL"
                             Text="{x:Bind ViewModel.AiApiBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="NavContact" helpers:Loc.Uid="NavContact" Text="Contact Becetti" Style="{StaticResource ValueStyle}" />
                    <TextBlock x:Uid="SettingsContactHint" helpers:Loc.Uid="SettingsContactHint" Text="Address used to prefill the support draft on the Contact Becetti page."
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12" TextWrapping="Wrap" />
                    <TextBox x:Uid="SettingsSupportEmail" helpers:Loc.Uid="SettingsSupportEmail" Header="Support email address"
                             Text="{x:Bind ViewModel.SupportEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="SettingsCriticalAlertsLabel" helpers:Loc.Uid="SettingsCriticalAlertsLabel" Text="Critical Alerts" Style="{StaticResource ValueStyle}" />
                    <TextBlock x:Uid="SettingsCriticalAlertsDescription" helpers:Loc.Uid="SettingsCriticalAlertsDescription"
                               Text="A critical event (threat found, a checked email/password found in a breach, a malicious scan result) always shows a Windows notification. Optionally, it can also be posted to a webhook URL (Slack, Discord or any generic JSON endpoint) so it reaches another device."
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12" TextWrapping="Wrap" />
                    <ToggleSwitch x:Uid="SettingsCriticalAlertsToggle" helpers:Loc.Uid="SettingsCriticalAlertsToggle" Header="Show a Windows notification for critical events" IsOn="{x:Bind ViewModel.CriticalAlertNotificationsEnabled, Mode=TwoWay}" />
                    <TextBox x:Uid="SettingsCriticalAlertsWebhook" helpers:Loc.Uid="SettingsCriticalAlertsWebhook" Header="Webhook URL (optional)"
                             PlaceholderText="https://hooks.slack.com/services/..."
                             Text="{x:Bind ViewModel.CriticalAlertWebhookUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Uid="SettingsSaveButton" helpers:Loc.Uid="SettingsSaveButton" Content="Save Settings" Command="{x:Bind ViewModel.SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                <Button x:Uid="SettingsTestConnectionButton" helpers:Loc.Uid="SettingsTestConnectionButton" Content="Test Cloud Connection" Command="{x:Bind ViewModel.TestConnectionCommand}" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
