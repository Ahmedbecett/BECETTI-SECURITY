<Page
    x:Class="Becetti.Security.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer Background="{StaticResource AppBackgroundBrush}">
        <StackPanel Padding="32" MaxWidth="900">
            <TextBlock x:Uid="TitleSettings" Text="Settings" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Uid="SubtitleSettings" Text="Every setting here is stored and applied. Nothing is decorative." Style="{StaticResource SectionSubtitleStyle}" TextWrapping="Wrap" />
            <InfoBar Title="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Margin="0,0,0,16" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="32" Height="32" Margin="0,0,0,16" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Language / اللغة" Style="{StaticResource ValueStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                        <RadioButton Content="English" IsChecked="{x:Bind ViewModel.IsEnglish, Mode=TwoWay}" />
                        <RadioButton Content="العربية (Arabic)" IsChecked="{x:Bind ViewModel.IsArabic, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Cloud API URL" Style="{StaticResource ValueStyle}" />
                    <TextBlock Text="Leave empty to disable cloud features. The app never invents cloud data." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12" TextWrapping="Wrap" />
                    <TextBox Text="{x:Bind ViewModel.ApiBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="https://api.becetti.security" Margin="0,0,0,12" />
                    <TextBlock Text="{x:Bind ViewModel.ConnectionText, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Theme" Style="{StaticResource ValueStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                        <RadioButton Content="Dark" GroupName="Theme" IsChecked="{x:Bind ViewModel.IsDark, Mode=TwoWay}" />
                        <RadioButton Content="Light" GroupName="Theme" IsChecked="{x:Bind ViewModel.IsLight, Mode=TwoWay}" />
                        <RadioButton Content="System" GroupName="Theme" IsChecked="{x:Bind ViewModel.IsSystem, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Telemetry" Style="{StaticResource ValueStyle}" />
                    <TextBlock Text="Off by default. BECETTI SECURITY collects no telemetry unless you opt in here." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12" TextWrapping="Wrap" />
                    <ToggleSwitch Header="Allow telemetry" IsOn="{x:Bind ViewModel.TelemetryOptIn, Mode=TwoWay}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Appearance &amp; Feedback" Style="{StaticResource ValueStyle}" />
                    <TextBlock Text="Animations are purely decorative and never used to imply a scan or update is running. Sounds play only on genuine completed/failed actions." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12" TextWrapping="Wrap" />
                    <ToggleSwitch x:Uid="SettingsAnimations" Header="Enable decorative animations" IsOn="{x:Bind ViewModel.EnableAnimations, Mode=TwoWay}" />
                    <ToggleSwitch x:Uid="SettingsSounds" Header="Enable sound cues" IsOn="{x:Bind ViewModel.EnableSounds, Mode=TwoWay}" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Save Settings" Command="{x:Bind ViewModel.SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                <Button Content="Test Cloud Connection" Command="{x:Bind ViewModel.TestConnectionCommand}" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
