<Page
    x:Class="Becetti.Security.App.Views.YaraScannerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Becetti.Security.App.Converters"
    xmlns:helpers="using:Becetti.Security.App.Helpers"
    xmlns:models="using:Becetti.Security.Core.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BoolToStatusBrushConverter x:Key="BoolToStatusBrush" />
        <converters:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
    </Page.Resources>

    <ScrollViewer Background="{StaticResource AppBackgroundBrush}">
        <StackPanel Padding="32" MaxWidth="960">
            <TextBlock x:Uid="TitleYara" helpers:Loc.Uid="TitleYara" Text="YARA Malware Engine" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Uid="SubtitleYara" helpers:Loc.Uid="SubtitleYara"
                       Text="Real local malware detection powered by the official open-source YARA x64 engine (VirusTotal/yara). Rules are validated and compiled locally before scanning — never simulated."
                       Style="{StaticResource SectionSubtitleStyle}" TextWrapping="Wrap" />

            <InfoBar Title="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Severity="Error"
                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Margin="0,0,0,16" />

            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="32" Height="32" Margin="0,0,0,16" />

            <!-- Native Engine Status Hero Card -->
            <Border Style="{StaticResource GlassHeroCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center"
                             Fill="{x:Bind ViewModel.IsEngineAvailable, Mode=OneWay, Converter={StaticResource BoolToStatusBrush}}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.EngineStatusText, Mode=OneWay}" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.EngineDetailText, Mode=OneWay}" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" x:Uid="RefreshButton" helpers:Loc.Uid="RefreshButton" Content="Refresh"
                            Command="{x:Bind ViewModel.RefreshEngineCommand}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Local File / Folder Scanner Card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="YaraScannerSectionLabel" helpers:Loc.Uid="YaraScannerSectionLabel"
                               Text="Local File &amp; Folder Scanner" Style="{StaticResource ValueStyle}" />
                    <TextBlock x:Uid="YaraScannerSectionNote" helpers:Loc.Uid="YaraScannerSectionNote"
                               Text="Choose any file or folder to scan locally with compiled YARA rules, or run a quick scan of Downloads, Desktop and Temp."
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{x:Bind ViewModel.TargetPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="C:\path\to\file-or-folder" />
                        <Button Grid.Column="1" x:Uid="YaraBrowseFileButton" helpers:Loc.Uid="YaraBrowseFileButton"
                                Content="Browse File..." Click="BrowseFileButton_Click" />
                        <Button Grid.Column="2" x:Uid="YaraBrowseFolderButton" helpers:Loc.Uid="YaraBrowseFolderButton"
                                Content="Browse Folder..." Click="BrowseFolderButton_Click" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                        <Button x:Uid="YaraStartScanButton" helpers:Loc.Uid="YaraStartScanButton"
                                Content="Scan with YARA" Command="{x:Bind ViewModel.ScanTargetCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button x:Uid="YaraQuickLocalScanButton" helpers:Loc.Uid="YaraQuickLocalScanButton"
                                Content="Quick Local Scan" Command="{x:Bind ViewModel.QuickLocalScanCommand}" />
                        <Button x:Uid="YaraCancelScanButton" helpers:Loc.Uid="YaraCancelScanButton"
                                Content="Cancel" Command="{x:Bind ViewModel.CancelScanCommand}"
                                Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <!-- Real Scan Progress -->
                    <StackPanel Spacing="6" Margin="0,8,0,0"
                                Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="8" />
                        <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" Foreground="{StaticResource ElectricBlueBrush}" FontSize="13" />
                        <TextBlock Text="{x:Bind ViewModel.CurrentFileText, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Scan Report & Matched Rules Card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="YaraResultsSectionLabel" helpers:Loc.Uid="YaraResultsSectionLabel"
                               Text="Scan Report &amp; Matched Rules" Style="{StaticResource ValueStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.VerdictText, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.ReportSummaryText, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.ReportSummaryText, Mode=OneWay, Converter={StaticResource NotEmptyToVisibility}}" />

                    <!-- Export & AI Explanation Actions -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                Visibility="{x:Bind ViewModel.HasReport, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Button x:Uid="SaveAsTextButton" helpers:Loc.Uid="SaveAsTextButton" Content="Save as Text" Click="SaveTextReport_Click" />
                        <Button x:Uid="YaraSaveJsonButton" helpers:Loc.Uid="YaraSaveJsonButton" Content="Save as JSON" Click="SaveJsonReport_Click" />
                        <Button x:Uid="SaveAsPdfButton" helpers:Loc.Uid="SaveAsPdfButton" Content="Save as PDF" Click="SavePdfReport_Click" />
                        <Button x:Uid="AskAiAboutScanButton" helpers:Loc.Uid="AskAiAboutScanButton" Content="Ask BECETTI AI to explain this" Click="AskAiAboutYara_Click" />
                    </StackPanel>

                    <!-- Matched Rules List -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Matches, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.HasMatches, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:YaraRuleMatch">
                                <Border Background="{StaticResource PanelBackgroundBrush}"
                                        BorderBrush="{StaticResource DangerBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,6,0,0">
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind RuleName}" FontSize="15" FontWeight="Bold"
                                                       Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Severity}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource WarningBrush}" Margin="12,0,0,0" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind Description}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind FilePath}" Foreground="{StaticResource ElectricBlueBrush}" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind TagsText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                   Visibility="{x:Bind TagsText, Converter={StaticResource NotEmptyToVisibility}}" />
                                        <TextBlock Text="{x:Bind MatchedStringsText}" Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="{x:Bind MatchedStringsText, Converter={StaticResource NotEmptyToVisibility}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Honest Scan Errors / Skipped Files -->
                    <StackPanel Spacing="4" Margin="0,8,0,0"
                                Visibility="{x:Bind ViewModel.HasScanErrors, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock x:Uid="YaraScanErrorsLabel" helpers:Loc.Uid="YaraScanErrorsLabel"
                                   Text="Scan Errors / Skipped Files" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.ScanErrors, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:YaraScanError">
                                    <TextBlock Text="{x:Bind DisplayLine}" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- YARA Rules Management Card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="YaraRulesManagementLabel" helpers:Loc.Uid="YaraRulesManagementLabel"
                               Text="YARA Rules Management (.yar / .yara)" Style="{StaticResource ValueStyle}" />
                    <TextBlock x:Uid="YaraRulesManagementNote" helpers:Loc.Uid="YaraRulesManagementNote"
                               Text="Every rule file is validated with yarac64 before loading. Invalid or outdated rule files are isolated automatically and never break the scanner."
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Uid="YaraImportRuleButton" helpers:Loc.Uid="YaraImportRuleButton"
                                Content="Import .yar / .yara Rule..." Click="ImportRuleButton_Click"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button x:Uid="YaraRecompileRulesButton" helpers:Loc.Uid="YaraRecompileRulesButton"
                                Content="Validate &amp; Recompile All" Command="{x:Bind ViewModel.RebuildRulesCommand}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.RuleFiles, Mode=OneWay}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:YaraRuleFileInfo">
                                <Border Background="{StaticResource PanelBackgroundBrush}"
                                        BorderBrush="{StaticResource GlowBorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,6,0,0">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind SourceName}" FontSize="12" Foreground="{StaticResource ElectricBlueBrush}" />
                                            <TextBlock Text="{x:Bind StatusSummary}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Enable / Disable" Tag="{x:Bind}" Click="ToggleRuleButton_Click" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="Remove" Tag="{x:Bind}" Click="RemoveRuleButton_Click"
                                                Visibility="{x:Bind CanDelete, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Update Rules from Trusted Repositories Card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="YaraUpdateRepoLabel" helpers:Loc.Uid="YaraUpdateRepoLabel"
                               Text="Update Rules from Trusted Repositories" Style="{StaticResource ValueStyle}" />
                    <TextBlock x:Uid="YaraUpdateRepoNote" helpers:Loc.Uid="YaraUpdateRepoNote"
                               Text="Downloaded rules are staged and individually compiled with yarac64 before activation. Any invalid or incompatible rule file is rejected safely."
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.TrustedRepositories, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedRepository, Mode=TwoWay}"
                                  DisplayMemberPath="Name" />
                        <Button Grid.Column="1" x:Uid="YaraUpdateFromRepoButton" helpers:Loc.Uid="YaraUpdateFromRepoButton"
                                Content="Update Rules" Command="{x:Bind ViewModel.UpdateFromRepositoryCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                    <Grid ColumnSpacing="8" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{x:Bind ViewModel.CustomRuleUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="https://raw.githubusercontent.com/.../rules.yar" />
                        <Button Grid.Column="1" x:Uid="YaraDownloadUrlButton" helpers:Loc.Uid="YaraDownloadUrlButton"
                                Content="Download &amp; Validate URL" Command="{x:Bind ViewModel.UpdateFromCustomUrlCommand}" />
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.RuleUpdateSummary, Mode=OneWay}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.RuleUpdateSummary, Mode=OneWay, Converter={StaticResource NotEmptyToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- License Attribution Card (BSD-3-Clause compliance) -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="YaraLicenseTitle" helpers:Loc.Uid="YaraLicenseTitle"
                               Text="YARA Open-Source License Notice" Style="{StaticResource ValueStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.LicenseNoticeText, Mode=OneWay}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
