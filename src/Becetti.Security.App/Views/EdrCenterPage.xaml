<Page
    x:Class="Becetti.Security.App.Views.EdrCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Becetti.Security.Core.Models"
    xmlns:helpers="using:Becetti.Security.App.Helpers"
    mc:Ignorable="d">

    <ScrollViewer Background="{StaticResource AppBackgroundBrush}">
        <StackPanel Padding="32" MaxWidth="1040" Spacing="16">

            <!-- Header -->
            <StackPanel>
                <TextBlock x:Uid="TitleEdrCenter" helpers:Loc.Uid="TitleEdrCenter" Text="EDR &amp; Windows Hardening" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Uid="SubtitleEdrCenter" helpers:Loc.Uid="SubtitleEdrCenter"
                           Text="Deep Persistence Hunter, Hosts &amp; DNS Guard, Camera/Mic Auditor, Script/LOLBins Decoder, URL Phishing Inspector, File Integrity Monitor, Windows Hardening &amp; Forensic Evidence Bundle."
                           Style="{StaticResource SectionSubtitleStyle}" TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar Title="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" />
            <InfoBar Title="Status" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Severity="Success" IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}" IsClosable="False" />
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

            <!-- 1. Windows Hardening & Attack Surface Auditor -->
            <Border Style="{StaticResource GlassHeroCardStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.HardeningScoreText, Mode=OneWay}"
                                   FontSize="42" FontWeight="Bold" Foreground="{StaticResource ElectricBlueBrush}"
                                   VerticalAlignment="Center" Margin="0,0,18,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Uid="EdrHardeningTitle" helpers:Loc.Uid="EdrHardeningTitle" Text="Windows Hardening &amp; Attack Surface Auditor" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.HardeningSummary, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2" x:Uid="EdrHardeningAuditBtn" helpers:Loc.Uid="EdrHardeningAuditBtn" Content="Audit Windows Hardening" Command="{x:Bind ViewModel.AuditHardeningCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" />
                    </Grid>
                    <CheckBox Content="Create Windows System Restore Point automatically before applying 1-click fixes"
                              IsChecked="{x:Bind ViewModel.CreateRestorePointBeforeFix, Mode=TwoWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.HardeningChecks, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:HardeningCheckItem">
                                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource GlowBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{x:Bind DisplayLine}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Recommendation}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Fix Now" Style="{StaticResource PrimaryButtonStyle}"
                                                Visibility="{x:Bind CanAutoFix}" Click="RemediateHardening_Click" Tag="{x:Bind}"
                                                FontSize="12" Padding="12,5" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 2. Deep Persistence Hunter (Autoruns Pro) -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Uid="EdrPersistenceTitle" helpers:Loc.Uid="EdrPersistenceTitle" Text="Deep Persistence Hunter (Autoruns Pro)" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.PersistenceSummary, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Uid="EdrPersistenceAuditBtn" helpers:Loc.Uid="EdrPersistenceAuditBtn" Content="Audit Persistence" Command="{x:Bind ViewModel.AuditPersistenceCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.PersistenceEntries, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PersistenceEntry">
                                <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource GlowBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{x:Bind SummaryLine}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Command}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind RiskReason}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <Button Content="YARA Scan" Click="ScanPersistenceWithYara_Click" Tag="{x:Bind ExecutablePath}" FontSize="12" Padding="10,5" />
                                            <Button Content="Ask AI" Click="AskAiAboutPersistence_Click" Tag="{x:Bind}" FontSize="12" Padding="10,5" />
                                            <Button Content="Disable" Click="DisablePersistenceTask_Click" Tag="{x:Bind}" Visibility="{x:Bind CanDisable}" FontSize="12" Padding="10,5" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 3. Hosts File & DNS Hijack Guard -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="EdrHostsDnsTitle" helpers:Loc.Uid="EdrHostsDnsTitle" Text="Hosts File &amp; DNS Hijack Guard" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.HostsSummary, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <ToggleSwitch x:Uid="EdrHostsWatchToggle" helpers:Loc.Uid="EdrHostsWatchToggle" Header="Watch System32\drivers\etc\hosts in real time" IsOn="{x:Bind ViewModel.HostsGuardWatching, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="EdrHostsAuditBtn" helpers:Loc.Uid="EdrHostsAuditBtn" Content="Audit Hosts &amp; DNS" Command="{x:Bind ViewModel.AuditHostsDnsCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Content="Cloudflare Malware DNS (1.1.1.2)" Command="{x:Bind ViewModel.ApplyCloudflareDnsCommand}" />
                        <Button Content="Quad9 Secure DNS (9.9.9.9)" Command="{x:Bind ViewModel.ApplyQuad9DnsCommand}" />
                        <Button Content="Restore Auto DHCP" Command="{x:Bind ViewModel.RestoreDhcpDnsCommand}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.AdapterDnsList, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:AdapterDnsInfo">
                                <TextBlock Text="{x:Bind DisplayLine}" Foreground="{StaticResource ElectricBlueBrush}" FontSize="12" Margin="0,2" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.HostsMappings, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:HostsMappingEntry">
                                <TextBlock Text="{x:Bind DisplayLine}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 4. Camera & Microphone Privacy Access Auditor -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Uid="EdrCamMicTitle" helpers:Loc.Uid="EdrCamMicTitle" Text="Camera &amp; Microphone Access Auditor" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.CameraMicSummary, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Uid="EdrCamMicAuditBtn" helpers:Loc.Uid="EdrCamMicAuditBtn" Content="Audit Camera &amp; Mic" Command="{x:Bind ViewModel.AuditCameraMicCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.CameraMicEntries, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:DevicePrivacyAccessEntry">
                                <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource GlowBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,4">
                                    <TextBlock Text="{x:Bind DisplayLine}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 5. Suspicious PowerShell & LOLBins Auditor + Base64 Decoder -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Uid="EdrScriptTitle" helpers:Loc.Uid="EdrScriptTitle" Text="PowerShell &amp; LOLBins Script Auditor" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ScriptSummary, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Uid="EdrScriptAuditBtn" helpers:Loc.Uid="EdrScriptAuditBtn" Content="Audit Scripts &amp; LOLBins" Command="{x:Bind ViewModel.AuditScriptsCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.ScriptFindings, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SuspiciousScriptEvent">
                                <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource GlowBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind DisplayLine}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind RawCommand}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                        <Button Content="Analyze with BECETTI AI" Click="AskAiAboutScript_Click" Tag="{x:Bind RawCommand}" FontSize="12" Padding="10,4" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Base64 / -EncodedCommand De-obfuscator" Style="{StaticResource LabelStyle}" Margin="0,6,0,0" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" PlaceholderText="Paste PowerShell -EncodedCommand or Base64 string..." Text="{x:Bind ViewModel.Base64Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Decode" Command="{x:Bind ViewModel.DecodeBase64Command}" />
                        <Button Grid.Column="2" Content="Ask BECETTI AI" Click="AskAiAboutDecoded_Click" />
                    </Grid>
                    <TextBox IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                             Text="{x:Bind ViewModel.DecodedBase64Output, Mode=OneWay}"
                             PlaceholderText="Decoded PowerShell / script payload appears here..." />
                </StackPanel>
            </Border>

            <!-- 6. Phishing & Homograph URL Inspector -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="EdrUrlTitle" helpers:Loc.Uid="EdrUrlTitle" Text="Phishing &amp; Homograph URL Inspector" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.UrlReportSummary, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" PlaceholderText="https://example.com or suspicious link..." Text="{x:Bind ViewModel.UrlToInspect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" x:Uid="EdrUrlInspectBtn" helpers:Loc.Uid="EdrUrlInspectBtn" Content="Inspect URL" Command="{x:Bind ViewModel.InspectUrlCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Grid.Column="2" Content="Ask BECETTI AI" Click="AskAiAboutUrl_Click" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.UrlFindings, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,2" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 7. File Integrity Monitor (FIM) -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="EdrFimTitle" helpers:Loc.Uid="EdrFimTitle" Text="File Integrity Monitor (SHA-256 FIM)" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.FimSummary, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <ToggleSwitch x:Uid="EdrFimWatchToggle" helpers:Loc.Uid="EdrFimWatchToggle" Header="Real-Time File Integrity Watcher" IsOn="{x:Bind ViewModel.FimWatching, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="EdrFimAddBtn" helpers:Loc.Uid="EdrFimAddBtn" Content="Track Sensitive File" Click="AddFimFile_Click" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button x:Uid="EdrFimVerifyBtn" helpers:Loc.Uid="EdrFimVerifyBtn" Content="Verify All Now" Command="{x:Bind ViewModel.VerifyFimCommand}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.FimItems, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:FimCheckItem">
                                <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource GlowBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{x:Bind DisplayLine}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind FilePath}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Content="Re-baseline" Click="RebaselineFim_Click" Tag="{x:Bind FilePath}" FontSize="12" Padding="10,4" />
                                            <Button Content="Remove" Click="UntrackFim_Click" Tag="{x:Bind FilePath}" FontSize="12" Padding="10,4" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 8. Forensic Incident Evidence Bundle (ZIP) -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Uid="EdrEvidenceTitle" helpers:Loc.Uid="EdrEvidenceTitle" Text="Forensic Incident Evidence Bundle (.ZIP)" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.EvidenceSummary, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Uid="EdrEvidenceExportBtn" helpers:Loc.Uid="EdrEvidenceExportBtn" Content="Export Forensic ZIP" Command="{x:Bind ViewModel.ExportEvidenceCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
