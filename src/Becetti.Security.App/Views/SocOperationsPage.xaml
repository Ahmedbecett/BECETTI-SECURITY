<Page
    x:Class="Becetti.Security.App.Views.SocOperationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28,24,28,40" Spacing="18">

            <!-- Header -->
            <Border Style="{StaticResource GlassHeroCardStyle}" Padding="22">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="SocOps_Header"
                                   Text="SOC Operations &amp; Active Hunting"
                                   Style="{StaticResource PageTitleStyle}" />
                        <TextBlock x:Uid="SocOps_Subtitle"
                                   Text="Local SIEM Correlation · Sigma YAML Rules · Live Process Tree · SOAR Containment · EML Phishing Forensics · Root CA Audit"
                                   Style="{StaticResource SectionSubtitleStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ProgressRing Grid.Column="1"
                                  IsActive="{Binding IsBusy}"
                                  Width="32" Height="32"
                                  VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Live Status / Error Banners -->
            <InfoBar IsOpen="{Binding HasStatus}"
                     Severity="Success"
                     Message="{Binding StatusMessage}"
                     IsClosable="True" />
            <InfoBar IsOpen="{Binding HasError}"
                     Severity="Error"
                     Message="{Binding ErrorMessage}"
                     IsClosable="True" />

            <!-- 6-Tab SOC Enterprise Pivot -->
            <Pivot>
                <!-- TAB 1: #1 Local SIEM & Event Correlation -->
                <PivotItem Header="Local SIEM">
                    <StackPanel Spacing="14" Padding="0,14,0,0">
                        <Border Style="{StaticResource CardStyle}" Padding="18">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Collect &amp; Correlate Windows Events"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding RunSiemCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding SiemSummary}" TextWrapping="Wrap" Opacity="0.9" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Correlated SOC Incidents" FontWeight="SemiBold" FontSize="15" />
                                <ListView ItemsSource="{Binding SiemIncidents}" MaxHeight="200" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,8" Margin="0,3" CornerRadius="8" Background="#1AFFFFFF">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{Binding DisplayLine}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Evidence}" Opacity="0.8" FontSize="12" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Live Windows Event Stream (Security / PowerShell / Defender / System)" FontWeight="SemiBold" FontSize="15" />
                                <ListView ItemsSource="{Binding SiemEvents}" MaxHeight="320" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayLine}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,2" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </PivotItem>

                <!-- TAB 2: #9 Local Sigma Rule Scanner -->
                <PivotItem Header="Sigma Rules">
                    <StackPanel Spacing="14" Padding="0,14,0,0">
                        <Border Style="{StaticResource CardStyle}" Padding="18">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Scan Events with Sigma Rules"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding RunSigmaScanCommand}" />
                                    <Button Content="Import Custom .YML Rule…"
                                            Click="OnImportSigmaYamlClick" />
                                </StackPanel>
                                <TextBlock Text="{Binding SigmaSummary}" TextWrapping="Wrap" Opacity="0.9" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Sigma Detections" FontWeight="SemiBold" FontSize="15" />
                                <ListView ItemsSource="{Binding SigmaMatches}" MaxHeight="240" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8" Margin="0,2" CornerRadius="6" Background="#22EF4444">
                                                <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap" FontSize="12.5" />
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Loaded Sigma Detection Rules" FontWeight="SemiBold" FontSize="15" />
                                <ListView ItemsSource="{Binding SigmaRules}" MaxHeight="240" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayLine}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </PivotItem>

                <!-- TAB 3: #8 Live Process Tree & Anomaly Hunter -->
                <PivotItem Header="Process Tree">
                    <StackPanel Spacing="14" Padding="0,14,0,0">
                        <Border Style="{StaticResource CardStyle}" Padding="18">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Capture Live Process Tree"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding CaptureProcessTreeCommand}" />
                                    <Button Content="Kill Selected Process Tree"
                                            Command="{Binding KillSelectedProcessCommand}" />
                                    <Button Content="Ask BECETTI AI"
                                            Command="{Binding AskAiAboutSelectedProcessCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding ProcTreeSummary}" TextWrapping="Wrap" Opacity="0.9" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Padding="16">
                            <ListView ItemsSource="{Binding Processes}"
                                      SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                                      MaxHeight="420">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="4,6" Spacing="2">
                                            <TextBlock Text="{Binding DisplayLine}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding CommandLine}" FontFamily="Consolas" FontSize="11.5" Opacity="0.72" TextWrapping="Wrap" MaxLines="2" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </StackPanel>
                </PivotItem>

                <!-- TAB 4: #4 SOAR Automated Incident Response Playbooks -->
                <PivotItem Header="SOAR Playbooks">
                    <StackPanel Spacing="14" Padding="0,14,0,0">
                        <Border Style="{StaticResource CardStyle}" Padding="18">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Automated Containment Playbook Policy" FontWeight="SemiBold" FontSize="15" />
                                <ToggleSwitch Header="Auto-Kill Suspicious Process Tree" IsOn="{Binding SoarAutoKill, Mode=TwoWay}" />
                                <ToggleSwitch Header="Auto-Block Executable in Windows Firewall" IsOn="{Binding SoarAutoFirewall, Mode=TwoWay}" />
                                <ToggleSwitch Header="Auto-Quarantine File (AES-256-GCM Vault)" IsOn="{Binding SoarAutoQuarantine, Mode=TwoWay}" />
                                <ToggleSwitch Header="Auto-Generate Forensic Evidence ZIP (SHA-256)" IsOn="{Binding SoarGenerateEvidence, Mode=TwoWay}" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Header="Target PID (optional)" PlaceholderText="e.g. 4812" Text="{Binding SoarTargetPidText, Mode=TwoWay}" />
                                    <TextBox Grid.Column="1" Header="Target Executable / File Path (optional)" PlaceholderText="C:\path\to\suspect.exe" Text="{Binding SoarTargetPath, Mode=TwoWay}" />
                                </Grid>

                                <TextBox Header="Incident Trigger Reason" Text="{Binding SoarReason, Mode=TwoWay}" />

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Save Playbook Policy" Command="{Binding SaveSoarConfigCommand}" />
                                    <Button Content="Execute Containment Playbook Now" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ExecuteSoarCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding SoarSummary}" TextWrapping="Wrap" Opacity="0.9" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="SOAR Execution Audit Trail" FontWeight="SemiBold" FontSize="15" />
                                <ListView ItemsSource="{Binding SoarExecutionLogs}" MaxHeight="260" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,2" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </PivotItem>

                <!-- TAB 5: #7 EML Email Phishing & Header Forensics -->
                <PivotItem Header="Email Forensics">
                    <StackPanel Spacing="14" Padding="0,14,0,0">
                        <Border Style="{StaticResource CardStyle}" Padding="18">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Open .EML File…" Style="{StaticResource PrimaryButtonStyle}" Click="OnOpenEmlFileClick" />
                                    <Button Content="Analyze Pasted Headers / Raw EML" Command="{Binding AnalyzeRawEmlCommand}" />
                                </StackPanel>
                                <TextBox Header="Paste Raw Email Headers / .EML Content"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="120"
                                         PlaceholderText="From: billing@bank-alert.example&#x0a;Reply-To: attacker@evil.tld&#x0a;Authentication-Results: spf=fail dkim=fail dmarc=fail"
                                         Text="{Binding EmlInputText, Mode=TwoWay}" />
                                <TextBlock Text="{Binding EmlSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding EmlMetaHeader}" FontFamily="Consolas" FontSize="12" Opacity="0.82" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Phishing &amp; Authentication Findings" FontWeight="SemiBold" FontSize="15" />
                                <ListView ItemsSource="{Binding EmlFindings}" MaxHeight="200" SelectionMode="None" />
                                <TextBlock Text="Extracted URLs" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,0" />
                                <ListView ItemsSource="{Binding EmlUrls}" MaxHeight="160" SelectionMode="None" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </PivotItem>

                <!-- TAB 6: #5 Windows Root Certificate Store Auditor -->
                <PivotItem Header="Root Cert Auditor">
                    <StackPanel Spacing="14" Padding="0,14,0,0">
                        <Border Style="{StaticResource CardStyle}" Padding="18">
                            <StackPanel Spacing="12">
                                <Button Content="Audit Windows Root CA Stores"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding AuditRootCertsCommand}" />
                                <TextBlock Text="{Binding RootCertSummary}" TextWrapping="Wrap" Opacity="0.9" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Padding="16">
                            <ListView ItemsSource="{Binding RootCerts}" MaxHeight="420" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="4,6" Spacing="2">
                                            <TextBlock Text="{Binding DisplayLine}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding RiskReason}" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </StackPanel>
                </PivotItem>
            </Pivot>
        </StackPanel>
    </ScrollViewer>
</Page>
