<Page
    x:Class="Becetti.Security.App.Views.GamePerformanceModePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Background="{StaticResource AppBackgroundBrush}">
        <StackPanel Padding="32" MaxWidth="900">
            <TextBlock x:Uid="TitleGameMode" Text="Game / Performance Mode" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Uid="SubtitleGameMode"
                       Text="Switches the real Windows power plan to High performance and turns on Windows' own Game Mode setting while active — the same settings available in Power Options and the Settings app. No invented FPS or performance numbers are shown; Windows exposes none honestly."
                       Style="{StaticResource SectionSubtitleStyle}" TextWrapping="Wrap" />

            <InfoBar Title="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Margin="0,0,0,16" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="32" Height="32" Margin="0,0,0,16" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="GameModeStatusLabel" Text="Current status" Style="{StaticResource ValueStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.Status.CurrentPowerPlanName, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0" />
                    <Button Content="{x:Bind ViewModel.ToggleButtonLabel, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,16,0,0" />
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
                    <Button x:Uid="RefreshButton" Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
