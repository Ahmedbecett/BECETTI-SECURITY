<Page
    x:Class="Becetti.Security.App.Views.PcHealthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Becetti.Security.App.Converters"
    xmlns:models="using:Becetti.Security.Core.Models"
    xmlns:helpers="using:Becetti.Security.App.Helpers"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:BoolToStatusBrushConverter x:Key="BoolToStatusBrush" />
    </Page.Resources>
    <ScrollViewer Background="{StaticResource AppBackgroundBrush}">
        <StackPanel Padding="32" MaxWidth="900">
            <TextBlock x:Uid="TitlePcHealth" helpers:Loc.Uid="TitlePcHealth" Text="Smart PC Health" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Uid="SubtitlePcHealth" helpers:Loc.Uid="SubtitlePcHealth"
                       Text="Live CPU, memory, disk and essential-service state, read directly from Windows — nothing cached or estimated."
                       Style="{StaticResource SectionSubtitleStyle}" TextWrapping="Wrap" />
            <InfoBar Title="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Margin="0,0,0,16" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="32" Height="32" Margin="0,0,0,16" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="CpuUsageLabel" helpers:Loc.Uid="CpuUsageLabel" Text="CPU usage" Style="{StaticResource LabelStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.CpuText, Mode=OneWay}" Style="{StaticResource ValueStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="MemoryUsageLabel" helpers:Loc.Uid="MemoryUsageLabel" Text="Memory usage" Style="{StaticResource LabelStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.MemoryText, Mode=OneWay}" Style="{StaticResource ValueStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="DisksLabel" helpers:Loc.Uid="DisksLabel" Text="Disks" Style="{StaticResource LabelStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Disks, Mode=OneWay}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:DiskHealthInfo">
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Bind DisplayName}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                        <ProgressBar Value="{x:Bind FreePercent}" Maximum="100" Width="260" HorizontalAlignment="Left" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Ellipse Grid.Column="1" Width="10" Height="10" VerticalAlignment="Center"
                                             Fill="{x:Bind HasEnoughSpace, Converter={StaticResource BoolToStatusBrush}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="EssentialServicesLabel" helpers:Loc.Uid="EssentialServicesLabel" Text="Essential services" Style="{StaticResource LabelStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Services, Mode=OneWay}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ServiceHealthInfo">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                             Fill="{x:Bind IsRunning, Converter={StaticResource BoolToStatusBrush}}" />
                                    <TextBlock Text="{x:Bind DisplayName}" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Status}" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}" />
            <TextBlock Text="{x:Bind ViewModel.LastCheckedText, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
