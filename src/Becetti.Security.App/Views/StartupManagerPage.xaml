<Page
    x:Class="Becetti.Security.App.Views.StartupManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Becetti.Security.Core.Models"
    xmlns:converters="using:Becetti.Security.App.Converters"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:BoolToStatusBrushConverter x:Key="BoolToStatusBrush" />
    </Page.Resources>
    <ScrollViewer Background="{StaticResource AppBackgroundBrush}">
        <StackPanel Padding="32" MaxWidth="900">
            <TextBlock x:Uid="TitleStartup" Text="Startup Manager" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Uid="SubtitleStartup"
                       Text="Real registry startup entries — the same Run-key and Task Manager convention Windows itself uses. No performance impact score is invented: Windows does not expose one through any stable API."
                       Style="{StaticResource SectionSubtitleStyle}" TextWrapping="Wrap" />
            <InfoBar Title="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Margin="0,0,0,16" />
            <InfoBar x:Uid="AdminRequiredInfoBar" Title="Administrator required"
                     Message="Changing this startup item requires an administrator. Restart BECETTI SECURITY as administrator from Settings."
                     Severity="Warning" IsOpen="{x:Bind ViewModel.SelectionNeedsElevation, Mode=OneWay}" IsClosable="False" Margin="0,0,0,16" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="32" Height="32" Margin="0,0,0,16" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <ListView ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}" MinHeight="240">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:StartupItemInfo">
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,4,12,0" VerticalAlignment="Top"
                                             Fill="{x:Bind IsEnabled, Converter={StaticResource BoolToStatusBrush}}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind Command}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" />
                                        <TextBlock Text="{x:Bind LocationDisplay}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
                        <Button x:Uid="RefreshButton" Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button x:Uid="EnableButton" Content="Enable" Command="{x:Bind ViewModel.EnableCommand}" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                        <Button x:Uid="DisableButton" Content="Disable" Command="{x:Bind ViewModel.DisableCommand}" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
