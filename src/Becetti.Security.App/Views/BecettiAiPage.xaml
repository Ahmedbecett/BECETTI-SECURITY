<Page
    x:Class="Becetti.Security.App.Views.BecettiAiPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Becetti.Security.App.Converters"
    xmlns:vm="using:Becetti.Security.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:AiMessageAlignmentConverter x:Key="MessageAlignment" />
    </Page.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: robot mascot + honesty banner -->
        <StackPanel Grid.Row="0" Padding="32,24,32,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Uid="TitleAi" Text="BECETTI AI" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock x:Uid="SubtitleAi"
                               Text="Ask BECETTI AI about your security status. It only answers from real, verified information — it never invents a threat or a fix."
                               Style="{StaticResource SectionSubtitleStyle}" TextWrapping="Wrap" />
                </StackPanel>
                <Image Grid.Column="1" Source="Assets/RobotMascotHero.png" Width="64" Height="64" VerticalAlignment="Center" />
            </Grid>

            <InfoBar Title="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Severity="Error"
                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Margin="0,12,0,0" />

            <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                <StackPanel>
                    <ToggleSwitch x:Uid="SettingsAiShareDeviceState"
                                  Header="Share real device/Defender status with BECETTI AI for this chat"
                                  IsOn="{x:Bind ViewModel.ShareDeviceState, Mode=TwoWay}" />
                    <ToggleSwitch x:Uid="SettingsAiSaveHistory"
                                  Header="Save chat history on this device"
                                  IsOn="{x:Bind ViewModel.SaveHistory, Mode=TwoWay}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Conversation -->
        <ScrollViewer Grid.Row="1" Padding="32,0" x:Name="ChatScroller">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AiChatMessage">
                        <Border HorizontalAlignment="{x:Bind IsFromUser, Converter={StaticResource MessageAlignment}}"
                                MaxWidth="560" Margin="0,6"
                                Padding="14,10"
                                CornerRadius="14"
                                Background="{StaticResource PanelBackgroundBrush}"
                                BorderBrush="{StaticResource GlowBorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Visibility="{x:Bind IsPending, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                <TextBlock Text="BECETTI AI is typing…" FontStyle="Italic"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Visibility="{x:Bind IsPending, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Composer -->
        <Grid Grid.Row="2" Padding="32,12,32,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="InputBox"
                     PlaceholderText="Ask BECETTI AI…"
                     Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="False" Margin="0,0,8,0" />
            <Button Grid.Column="1" Content="Send" Command="{x:Bind ViewModel.SendCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="Clear" Command="{x:Bind ViewModel.ClearCommand}" />
        </Grid>
    </Grid>
</Page>
