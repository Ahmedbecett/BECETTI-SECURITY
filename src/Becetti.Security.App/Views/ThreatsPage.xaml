<Page
    x:Class="Becetti.Security.App.Views.ThreatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Becetti.Security.Core.Models"
    mc:Ignorable="d">
    <ScrollViewer Background="{StaticResource AppBackgroundBrush}">
        <StackPanel Padding="32" MaxWidth="900">
            <TextBlock x:Uid="TitleThreats" Text="Threat Management" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Uid="SubtitleThreats" Text="Real detections reported by Microsoft Defender. Removal runs through Defender and is verified before success is shown." Style="{StaticResource SectionSubtitleStyle}" TextWrapping="Wrap" />
            <InfoBar Title="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Margin="0,0,0,16" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="32" Height="32" Margin="0,0,0,16" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <ListView ItemsSource="{x:Bind ViewModel.Threats, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedThreat, Mode=TwoWay}" MinHeight="200">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ThreatInfo">
                                <StackPanel Margin="0,8">
                                    <TextBlock Text="{x:Bind ThreatName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Severity}" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind Resources}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind DetectedAt}" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
                        <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Content="Remove Selected Threat" Command="{x:Bind ViewModel.RemoveSelectedCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Recovery &amp; Quarantine" Style="{StaticResource ValueStyle}" />
                    <TextBlock Text="BECETTI SECURITY never claims to quarantine or restore a file itself — removal above runs through Defender's own Remove-MpThreat and is verified by re-reading the threat list. Full quarantine history and file-restore actions live in Windows Security." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12" TextWrapping="Wrap" />
                    <Button Content="Open Windows Security Protection History" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" />
                </StackPanel>
            </Border>
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
