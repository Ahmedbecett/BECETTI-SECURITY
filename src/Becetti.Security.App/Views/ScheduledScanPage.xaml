<Page
    x:Class="Becetti.Security.App.Views.ScheduledScanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:Becetti.Security.App.Helpers"
    mc:Ignorable="d">

    <ScrollViewer Background="{StaticResource AppBackgroundBrush}">
        <StackPanel Padding="32" MaxWidth="900">
            <TextBlock x:Uid="TitleScheduledScan" helpers:Loc.Uid="TitleScheduledScan" Text="Scheduled Scan" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Uid="SubtitleScheduledScan" helpers:Loc.Uid="SubtitleScheduledScan"
                       Text="Registers a real Windows Scheduled Task (visible and editable in Task Scheduler) that runs a genuine Microsoft Defender scan daily — even while BECETTI SECURITY is closed. Creating or removing it requires an administrator."
                       Style="{StaticResource SectionSubtitleStyle}" TextWrapping="Wrap" />
            <InfoBar Title="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Margin="0,0,0,16" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="32" Height="32" Margin="0,0,0,16" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="ScheduleNewScanLabel" helpers:Loc.Uid="ScheduleNewScanLabel" Text="Schedule a daily scan" Style="{StaticResource ValueStyle}" />
                    <ToggleSwitch x:Uid="FullScanToggle" helpers:Loc.Uid="FullScanToggle" Header="Full scan (otherwise Quick scan)" IsOn="{x:Bind ViewModel.FullScan, Mode=TwoWay}" Margin="0,8,0,0" />
                    <TextBlock x:Uid="ScheduleHourLabel" helpers:Loc.Uid="ScheduleHourLabel" Text="Hour of day (0-23, local time)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,4" />
                    <NumberBox Value="{x:Bind ViewModel.SelectedHour, Mode=TwoWay}" SpinButtonPlacementMode="Inline" Minimum="0" Maximum="23" SmallChange="1" Width="160" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
                        <Button x:Uid="ScheduleScanButton" helpers:Loc.Uid="ScheduleScanButton" Content="Schedule" Command="{x:Bind ViewModel.ScheduleCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button x:Uid="RemoveScheduleButton" helpers:Loc.Uid="RemoveScheduleButton" Content="Remove Scheduled Scan" Command="{x:Bind ViewModel.RemoveCommand}" />
                        <Button x:Uid="RefreshButton" helpers:Loc.Uid="RefreshButton" Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
