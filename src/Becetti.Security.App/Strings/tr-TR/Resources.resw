  <data name="SettingsCriticalAlertsDescription.Text" xml:space="preserve">
    <value>A critical event (threat found, a checked email/password found in a breach, a malicious scan result) always shows a Windows notification. Optionally, it can also be posted to a webhook URL (Slack, Discord or any generic JSON endpoint) so it reaches another device.</value>
  </data>
  <data name="SettingsCriticalAlertsToggle.Header" xml:space="preserve">
