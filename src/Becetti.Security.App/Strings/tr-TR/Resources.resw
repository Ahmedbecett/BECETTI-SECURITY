  <data name="TitleRansomware.Text" xml:space="preserve">
    <value>Ransomware Defense</value>
  </data>
  <data name="SubtitleRansomware.Text" xml:space="preserve">
    <value>Microsoft Defender's own Controlled Folder Access (Exploit Guard). BECETTI SECURITY only reads and explains this real Windows feature — it never runs its own ransomware engine.</value>
  </data>
  <data name="ElevationRequiredInfoBar.Title" xml:space="preserve">
    <value>Administrator required</value>
  </data>
  <data name="ElevationRequiredInfoBar.Message" xml:space="preserve">
    <value>Changing Controlled Folder Access requires an administrator. Use Ayarlar → Restart as administrator.</value>
  </data>
  <data name="ProtectedFoldersLabel.Text" xml:space="preserve">
    <value>Protected folders</value>
  </data>
  <data name="RansomwareRecommendationLabel.Text" xml:space="preserve">
    <value>Recommendation</value>
  </data>
  <data name="RansomwareRecommendationText.Text" xml:space="preserve">
    <value>Add your most important personal folders (Documents, Pictures, Desktop) to Controlled Folder Access from Windows Güvenlik, so ransomware cannot silently encrypt or delete them. Ask BECETTI AI if you're not sure which folders to protect.</value>
  </data>
  <data name="EnableButton.Content" xml:space="preserve">
    <value>Enable</value>
  </data>
  <data name="DisableButton.Content" xml:space="preserve">
    <value>Disable</value>
  </data>
  <data name="TitlePcHealth.Text" xml:space="preserve">
    <value>Smart PC Health</value>
  </data>
  <data name="SubtitlePcHealth.Text" xml:space="preserve">
    <value>Live CPU, memory, disk and essential-service state, read directly from Windows — nothing cached or estimated.</value>
  </data>
  <data name="CpuUsageLabel.Text" xml:space="preserve">
    <value>CPU usage</value>
  </data>
  <data name="MemoryUsageLabel.Text" xml:space="preserve">
