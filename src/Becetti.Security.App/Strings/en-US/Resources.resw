  <data name="TitleParentalControl.Text" xml:space="preserve"><value>Parental Controls</value></data>
  <data name="SubtitleParentalControl.Text" xml:space="preserve"><value>Blocks websites on this device using the real Windows hosts file — the same mechanism Windows itself uses to resolve names. Changing it requires Administrator.</value></data>
