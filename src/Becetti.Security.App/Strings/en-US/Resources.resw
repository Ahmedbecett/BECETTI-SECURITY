  <data name="IpReputationReportsLabel.Text" xml:space="preserve"><value>Total reports:</value></data>
  <data name="IpReputationIspLabel.Text" xml:space="preserve"><value>ISP:</value></data>
  <data name="IpReputationCountryLabel.Text" xml:space="preserve"><value>Country:</value></data>
  <data name="IpReputationHistoryLabel.Text" xml:space="preserve"><value>Previous checks</value></data>
