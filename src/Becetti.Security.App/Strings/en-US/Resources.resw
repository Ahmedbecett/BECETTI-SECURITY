  <data name="TitleSecureVault.Text" xml:space="preserve"><value>Secure Vault</value></data>
  <data name="SubtitleSecureVault.Text" xml:space="preserve"><value>A local, encrypted (AES-256) storage area for files you choose to protect. The encryption key is bound to your Windows account on this device with DPAPI — nothing here is ever uploaded anywhere.</value></data>
  <data name="SecureVaultNotCreatedLabel.Text" xml:space="preserve"><value>No vault exists on this device yet.</value></data>
  <data name="SecureVaultCreateButton.Content" xml:space="preserve"><value>Create vault</value></data>
  <data name="SecureVaultAddLabel.Text" xml:space="preserve"><value>Add a file</value></data>
  <data name="SecureVaultBrowseButton.Content" xml:space="preserve"><value>Browse</value></data>
  <data name="SecureVaultShredOriginalCheckBox.Content" xml:space="preserve"><value>Securely delete the original file after encrypting it</value></data>
  <data name="SecureVaultAddButton.Content" xml:space="preserve"><value>Add to vault</value></data>
  <data name="SecureVaultItemsLabel.Text" xml:space="preserve"><value>Files in the vault</value></data>
