  <data name="TitleFileShredder.Text" xml:space="preserve"><value>Secure File Shredder</value></data>
  <data name="SubtitleFileShredder.Text" xml:space="preserve"><value>A normal delete only removes a file's entry from the folder — the bytes usually remain on disk until something else happens to overwrite them. This overwrites the file's real content with random data first, then deletes it, for files you choose to permanently destroy.</value></data>
  <data name="FileShredderPickLabel.Text" xml:space="preserve"><value>File to destroy</value></data>
  <data name="FileShredderBrowseButton.Content" xml:space="preserve"><value>Browse</value></data>
