<?xml version="1.0" encoding="utf-8"?>
<!--
https://go.microsoft.com/fwlink/?LinkID=208121.
Referenced by Becetti.Security.App.csproj as <PublishProfile>win-$(Platform).pubxml</PublishProfile>
so `dotnet build`/`dotnet publish -p:Platform=x64` resolve a real profile instead of
warning "A publish profile with the name 'win-x64.pubxml' was not found".
-->
<Project>
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Both set to true so the MSIX bundles its own .NET 8 runtime AND its own
         Windows App Runtime 1.8, instead of depending on either being separately
         installed on the target machine. This is what fixes "The application has
         failed to start because its side-by-side configuration is incorrect" when
         sideloading on a machine where the Microsoft Store couldn't auto-provision
         the framework packages (see docs/STORE-SUBMISSION.md). Trade-off: a larger
         .msix (~150-250 MB instead of a few MB) - acceptable for a reliable
         sideload test package; Store submissions commonly ship self-contained too. -->
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Platform>x64</Platform>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <WindowsPackageType>MSIX</WindowsPackageType>
  </PropertyGroup>
</Project>
