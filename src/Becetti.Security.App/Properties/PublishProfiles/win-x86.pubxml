<?xml version="1.0" encoding="utf-8"?>
<!--
https://go.microsoft.com/fwlink/?LinkID=208121.
Referenced by Becetti.Security.App.csproj as <PublishProfile>win-$(Platform).pubxml</PublishProfile>
so `dotnet build`/`dotnet publish -p:Platform=x86` resolve a real profile instead of
warning "A publish profile with the name 'win-x86.pubxml' was not found".
-->
<Project>
  <PropertyGroup>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Platform>x86</Platform>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <WindowsPackageType>MSIX</WindowsPackageType>
  </PropertyGroup>
</Project>
