<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- ApplicationManifest must be a classic Win32 "<assembly>"-rooted side-by-side manifest
         (app.manifest below), NOT the MSIX "Package.appxmanifest" (which has a "<Package>"
         root and is picked up separately and automatically by the MSIX/EnableMsixTooling
         packaging pipeline by filename convention - it needs no property of its own).
         This was previously set to Package.appxmanifest by mistake; that silently "worked"
         for a framework-dependent build because no manifest merge ever touched the file, but
         it broke the self-contained build below: WindowsAppSDKSelfContained=true runs an
         extra mt.exe merge step that reads $(ApplicationManifest) expecting an <assembly>
         root, and fails with "manifest authoring error c1010005: The root element name
         should be <assembly/>" when given the appxmanifest instead. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Logo.ico</ApplicationIcon>
    <RootNamespace>Becetti.Security.App</RootNamespace>
    <AssemblyName>Becetti.Security.App</AssemblyName>
    <Description>BECETTI SECURITY — Windows security center powered by Microsoft Defender and the BECETTI cloud API.</Description>
  </PropertyGroup>

  <!-- Package.appxmanifest needs no ItemGroup entry of its own: the .NET SDK's default-item
       globbing already picks it up as a None item (same mechanism noted below for *.resw),
       and the MSIX/EnableMsixTooling packaging pipeline finds it by filename convention. This
       already worked correctly across every prior CI build/package run before this change. -->

  <ItemGroup>
    <!-- 1.5.* silently swallowed the real XamlCompiler.exe diagnostic on build failure,
         reporting only "MSB3073: exited with code 1" with no file/line (fixed upstream in
         microsoft/microsoft-ui-xaml#9813, shipped in WinAppSDK 1.8.8+). Pinned to the latest
         1.8 servicing release so a real XAML error surfaces as an actual readable message. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.*" />
    <!-- Provides the IServiceCollection.AddHttpClient(...) extension used in App.xaml.cs. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Becetti.Security.Core\Becetti.Security.Core.csproj" />
  </ItemGroup>

  <!-- Bundled verified YARA rules, BSD-3-Clause license notice, and native Windows x64 YARA binaries
       (built by scripts/build-yara-win64.ps1 in CI and local Windows builds). -->
  <ItemGroup>
    <Content Include="Rules\yara\*.yar" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Rules\yara\*.yara" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Native\yara\win-x64\*" Condition="Exists('Native\yara\win-x64')" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-LICENSES\YARA-LICENSE.txt" Link="THIRD-PARTY-LICENSES\YARA-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- MG Ads host + config. Both folders are generated before the app build:
       scripts/build-mgads-host.ps1 builds the net472 host into MgAdsHost\ and
       writes MgAds\mgads.json from repository secrets. If either is absent
       (plain dev build), MgAdsService logs and the app runs ad-free. -->
  <ItemGroup>
    <Content Include="MgAds\**" Condition="Exists('MgAds')" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="MgAdsHost\**" Condition="Exists('MgAdsHost')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The .NET SDK already includes *.resw files from the project directory as PRIResource
       items by default (EnableDefaultPriItems). Declaring them again here duplicates the
       items and fails the build ("Duplicate 'PRIResource' items were included"). -->

</Project>
