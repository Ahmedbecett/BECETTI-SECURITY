<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <!--
    Microsoft Store identity. Publisher is set to the verified Microsoft
    Partner Center Windows Publisher ID for this account
    (CN=A5D5DC31-4A15-4059-8030-D96C51054596). This is the exact identity
    Partner Center issued - it is NOT by itself a trusted/CA-issued
    certificate; whatever certificate signs this package (currently a
    self-signed CI test certificate, see docs/STORE-SUBMISSION.md and
    docs/IMPLEMENTATION-REPORT.md) must have a Subject that matches this
    Publisher string exactly, or MSIX signing fails outright.

    IMPORTANT: Publisher is part of the package's identity together with
    Name. Changing Publisher (as done here, from the placeholder
    CN=BECETTI to the real Partner Center ID) changes package identity.
    Any machine that already side-loaded a build signed under the old
    CN=BECETTI identity cannot upgrade in place to a package signed under
    this new identity - Windows treats it as a different app and the old
    one must be uninstalled first before installing a build signed with
    this identity.
  -->
  <Identity
    Name="BECETTI.BECETTISECURITY"
    Publisher="CN=A5D5DC31-4A15-4059-8030-D96C51054596"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>BECETTI SECURITY</DisplayName>
    <PublisherDisplayName>Ahmedbecetti</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="ar-SA" />
    <Resource Language="fr-FR" />
    <Resource Language="es-ES" />
    <Resource Language="de-DE" />
    <Resource Language="tr-TR" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="Becetti.Security.App.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="BECETTI SECURITY"
        Description="Windows security center powered by Microsoft Defender and the BECETTI cloud API."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Full-trust desktop app: required for Defender integration via MpCmdRun/PowerShell. -->
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
  </Capabilities>

</Package>
