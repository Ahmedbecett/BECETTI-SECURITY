<Window
    x:Class="Becetti.Security.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:Becetti.Security.App.Helpers"
    xmlns:local="using:Becetti.Security.App"
    mc:Ignorable="d"
    Title="BECETTI SECURITY">

    <Grid x:Name="RootGrid" Background="{StaticResource AppBackgroundBrush}" RequestedTheme="Dark">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="CommandPaletteAccelerator_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView
            x:Name="NavView"
            Grid.Row="0"
            PaneDisplayMode="Left"
            OpenPaneLength="276"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneOpen="True"
            Background="{StaticResource AppBackgroundBrush}">

            <NavigationView.MenuItems>
                <!-- Group 1: Command & Active Protection -->
                <NavigationViewItem x:Uid="NavGroupProtection" helpers:Loc.Uid="NavGroupProtection" Content="Command &amp; Protection" SelectsOnInvoked="False" IsExpanded="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE83D;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem x:Uid="NavDashboard" helpers:Loc.Uid="NavDashboard" Content="Dashboard" Tag="Dashboard" IsSelected="True">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavEmergency" helpers:Loc.Uid="NavEmergency" Content="Emergency Center" Tag="Emergency">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE7BA;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavScan" helpers:Loc.Uid="NavScan" Content="Smart Scan" Tag="Scan">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE721;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavYara" helpers:Loc.Uid="NavYara" Content="YARA Engine" Tag="Yara">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D5;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavAdvancedDefense" helpers:Loc.Uid="NavAdvancedDefense" Content="Advanced Defense" Tag="AdvancedDefense">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE83D;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavEdrCenter" helpers:Loc.Uid="NavEdrCenter" Content="EDR &amp; Hardening" Tag="EdrCenter">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE9F5;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavProactiveDefense" helpers:Loc.Uid="NavProactiveDefense" Content="Proactive Defense &amp; Reports" Tag="ProactiveDefense">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE72E;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavProtection" helpers:Loc.Uid="NavProtection" Content="Real-Time Protection" Tag="Protection">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE7EF;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavRansomware" helpers:Loc.Uid="NavRansomware" Content="Ransomware Defense" Tag="Ransomware">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xEA18;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavThreats" helpers:Loc.Uid="NavThreats" Content="Threat Management" Tag="Threats">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE7BA;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>

                <!-- Group 2: AI & Threat Intelligence -->
                <NavigationViewItem x:Uid="NavGroupAiIntel" helpers:Loc.Uid="NavGroupAiIntel" Content="AI &amp; Intelligence" SelectsOnInvoked="False" IsExpanded="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE99A;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem x:Uid="NavAi" helpers:Loc.Uid="NavAi" Content="BECETTI AI" Tag="Ai">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE99A;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavGlobalIntel" helpers:Loc.Uid="NavGlobalIntel" Content="Global Intel &amp; Radar" Tag="GlobalIntel">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE774;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavThreatIntel" helpers:Loc.Uid="NavThreatIntel" Content="Threat Intelligence" Tag="ThreatIntel">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE7BA;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavIpReputation" helpers:Loc.Uid="NavIpReputation" Content="IP Reputation" Tag="IpReputation">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE704;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavDataBreach" helpers:Loc.Uid="NavDataBreach" Content="Data Breach Monitor" Tag="DataBreach">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D7;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavKnowledge" helpers:Loc.Uid="NavKnowledge" Content="Knowledge Base" Tag="Knowledge">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE82D;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>

                <!-- Group 3: Network & Privacy -->
                <NavigationViewItem x:Uid="NavGroupNetworkPrivacy" helpers:Loc.Uid="NavGroupNetworkPrivacy" Content="Network &amp; Privacy" SelectsOnInvoked="False" IsExpanded="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE968;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem x:Uid="NavNetwork" helpers:Loc.Uid="NavNetwork" Content="Network Monitor" Tag="Network">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE968;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavWifi" helpers:Loc.Uid="NavWifi" Content="Wi-Fi Security" Tag="Wifi">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE701;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavBrowser" helpers:Loc.Uid="NavBrowser" Content="Browser Security" Tag="Browser">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE774;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavIdentity" helpers:Loc.Uid="NavIdentity" Content="Identity Protection" Tag="Identity">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE77B;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavPrivacy" helpers:Loc.Uid="NavPrivacy" Content="Privacy &amp; Network" Tag="Privacy">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE774;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavSecureVault" helpers:Loc.Uid="NavSecureVault" Content="Secure Vault" Tag="SecureVault">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE72E;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavFileShredder" helpers:Loc.Uid="NavFileShredder" Content="File Shredder" Tag="FileShredder">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE74D;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavParentalControl" helpers:Loc.Uid="NavParentalControl" Content="Parental Controls" Tag="ParentalControl">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE716;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>

                <!-- Group 4: System & Device Health -->
                <NavigationViewItem x:Uid="NavGroupSystem" helpers:Loc.Uid="NavGroupSystem" Content="System &amp; Health" SelectsOnInvoked="False" IsExpanded="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem x:Uid="NavPcHealth" helpers:Loc.Uid="NavPcHealth" Content="Smart PC Health" Tag="PcHealth">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavStartup" helpers:Loc.Uid="NavStartup" Content="Startup Manager" Tag="Startup">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE7B5;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavSoftware" helpers:Loc.Uid="NavSoftware" Content="Software Manager" Tag="Software">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE7B8;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavDrivers" helpers:Loc.Uid="NavDrivers" Content="Driver Monitor" Tag="Drivers">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE9CE;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavUsb" helpers:Loc.Uid="NavUsb" Content="USB Protection" Tag="Usb">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE88E;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavVulnerability" helpers:Loc.Uid="NavVulnerability" Content="Vulnerability Advisor" Tag="Vulnerability">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE7BA;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavScheduledScan" helpers:Loc.Uid="NavScheduledScan" Content="Scheduled Scan" Tag="ScheduledScan">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE823;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavBackup" helpers:Loc.Uid="NavBackup" Content="Backup Advisor" Tag="Backup">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE7B3;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavGameMode" helpers:Loc.Uid="NavGameMode" Content="Game / Performance Mode" Tag="GameMode">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE7FC;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>

                <!-- Group 5: Cloud, Reports & Settings -->
                <NavigationViewItem x:Uid="NavGroupCloudSettings" helpers:Loc.Uid="NavGroupCloudSettings" Content="Cloud, Reports &amp; Settings" SelectsOnInvoked="False" IsExpanded="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem x:Uid="NavCloud" helpers:Loc.Uid="NavCloud" Content="Cloud Security" Tag="Cloud">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE753;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavCloudSync" helpers:Loc.Uid="NavCloudSync" Content="Cloud Sync" Tag="CloudSync">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE895;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavReports" helpers:Loc.Uid="NavReports" Content="Smart Security Reports" Tag="Reports">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE9F9;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavHistory" helpers:Loc.Uid="NavHistory" Content="Security History" Tag="History">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavUpdates" helpers:Loc.Uid="NavUpdates" Content="Updates" Tag="Updates">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE777;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavSettings" helpers:Loc.Uid="NavSettings" Content="Settings" Tag="Settings">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavContact" helpers:Loc.Uid="NavContact" Content="Contact Becetti" Tag="Contact">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE715;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="NavAbout" helpers:Loc.Uid="NavAbout" Content="About BECETTI SECURITY" Tag="About">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.Header>
                <Border Background="{StaticResource HeaderGradientBrush}"
                        BorderBrush="{StaticResource ShellDividerBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="20,12,20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Width="40" Height="40"
                                CornerRadius="10"
                                Background="{StaticResource CardElevatedBrush}"
                                BorderBrush="{StaticResource HeroBorderBrush}"
                                BorderThickness="1"
                                Padding="4"
                                Margin="0,0,14,0"
                                VerticalAlignment="Center">
                            <Image Source="Assets/Square150x150Logo.png" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Uid="AppHeaderTitle"
                                       helpers:Loc.Uid="AppHeaderTitle"
                                       Text="BECETTI SECURITY"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       CharacterSpacing="80"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock x:Uid="AppHeaderSubtitle"
                                       helpers:Loc.Uid="AppHeaderSubtitle"
                                       Text="Advanced Protection for Windows"
                                       FontSize="12"
                                       Foreground="{StaticResource ElectricBlueBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <!-- Instant Command Palette Trigger Pill -->
                            <Button x:Name="CommandPaletteButton"
                                    Click="CommandPaletteButton_Click"
                                    Background="#121824"
                                    BorderBrush="#223047"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,6"
                                    ToolTipService.ToolTip="Command Palette (Ctrl+K)">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE721;" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Uid="CommandPaletteTriggerLabel" helpers:Loc.Uid="CommandPaletteTriggerLabel" Text="Quick Search" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <Border Background="#1B2538" CornerRadius="4" Padding="6,1">
                                        <TextBlock Text="Ctrl+K" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ElectricBlueBrush}" />
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button x:Name="HelpButton" Style="{StaticResource HeaderIconButtonStyle}" Click="HelpButton_Click" ToolTipService.ToolTip="Help">
                                <FontIcon Glyph="&#xE897;" FontSize="15" />
                            </Button>
                            <Button x:Name="AboutButton" Style="{StaticResource HeaderIconButtonStyle}" Click="AboutButton_Click" ToolTipService.ToolTip="About">
                                <FontIcon Glyph="&#xE946;" FontSize="15" />
                            </Button>
                            <Button x:Name="SettingsButton" Style="{StaticResource HeaderIconButtonStyle}" Click="SettingsButton_Click" ToolTipService.ToolTip="Settings">
                                <FontIcon Glyph="&#xE713;" FontSize="15" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </NavigationView.Header>
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- Footer status bar: real, verified readiness only — never decorative. -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBackgroundBrush}"
                BorderBrush="{StaticResource ShellDividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource ShellBadgeStyle}" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse x:Name="ReadinessDot" Width="8" Height="8" Fill="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="FooterReadinessText" Text="Checking readiness…" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource ShellBadgeStyle}" Margin="0,0,8,0">
                    <TextBlock x:Name="FooterVersionText" Text="BECETTI SECURITY v1.0.0.0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                </Border>
                <Border Grid.Column="3" Style="{StaticResource ShellBadgeStyle}">
                    <TextBlock x:Name="FooterCompatText" Text="Windows 10 / 11 · x64" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- Fixed always-on-screen BECETTI AI launcher -->
        <Button x:Name="AiLauncherButton"
                Grid.Row="0" Grid.RowSpan="2"
                Click="AiLauncherButton_Click"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,28,44"
                Width="60" Height="60"
                CornerRadius="30"
                Padding="0"
                Background="{StaticResource AiOrbGradientBrush}"
                BorderBrush="{StaticResource HeroBorderBrush}"
                BorderThickness="1.5"
                ToolTipService.ToolTip="BECETTI AI">
            <Image Source="Assets/RobotMascotHero.png" Width="36" Height="36" Stretch="Uniform" />
        </Button>

        <!-- Global Ctrl+K Command Palette Overlay (Linear / VS Code Style) -->
        <Grid x:Name="CommandPaletteOverlay"
              Grid.Row="0" Grid.RowSpan="2"
              Visibility="Collapsed"
              Background="#B804070D"
              PointerPressed="CommandPaletteBackdrop_PointerPressed">
            <Border Width="580"
                    MaxHeight="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,72,0,0"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource HeroBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="0"
                    PointerPressed="CommandPaletteCard_PointerPressed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Search Bar -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource ShellDividerBrush}" BorderThickness="0,0,0,1" Padding="14,12">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="16" Foreground="{StaticResource ElectricBlueBrush}" VerticalAlignment="Center" />
                            <TextBox x:Name="CommandPaletteInput"
                                     Grid.Column="1"
                                     PlaceholderText="Jump to any security tool, scan, or action… (Type to filter)"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     TextChanged="CommandPaletteInput_TextChanged"
                                     KeyDown="CommandPaletteInput_KeyDown" />
                            <Button Grid.Column="2" Content="Esc" Click="CloseCommandPalette_Click" FontSize="11" Padding="8,4" />
                        </Grid>
                    </Border>

                    <!-- Matching Commands List -->
                    <ListView x:Name="CommandPaletteList"
                              Grid.Row="1"
                              MaxHeight="340"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              ItemClick="CommandPaletteList_ItemClick"
                              Padding="6">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:CommandPaletteItem">
                                <Grid Padding="8,7" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="1">
                                        <TextBlock Text="{x:Bind Title}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="{x:Bind Subtitle}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource ShellBadgeStyle}" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Category}" Foreground="{StaticResource ElectricBlueBrush}" FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Footer Hint -->
                    <Border Grid.Row="2" Background="{StaticResource FooterBackgroundBrush}" BorderBrush="{StaticResource ShellDividerBrush}" BorderThickness="0,1,0,0" Padding="14,8" CornerRadius="0,0,14,14">
                        <TextBlock Text="↑↓ Navigate · Enter Execute · Esc Close" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- World-Class 3-Step First-Run Onboarding Wizard Overlay (#4) -->
        <Grid x:Name="OnboardingOverlay"
              Grid.RowSpan="2"
              Visibility="Collapsed"
              Background="#CC05080F">
            <Border Width="640"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource HeroBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="28">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="6">
                        <TextBlock Text="BECETTI SECURITY" FontSize="12" FontWeight="Bold" CharacterSpacing="120" Foreground="{StaticResource ElectricBlueBrush}" />
                        <TextBlock x:Name="OnboardingTitle" Text="Welcome to Global Endpoint Protection" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="OnboardingSubtitle" Text="100% Real Windows APIs · Native YARA v4.6.0 · MITRE ATT&amp;CK EDR · Zero Simulation" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Step 1: Choose Global Language (6 Languages) -->
                    <Border x:Name="OnboardingStep1" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource GlowBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Step 1 of 3 — Choose Your Language (Instant Live Switch)" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" Grid.Column="0" Content="English" Tag="en" Click="OnboardingLanguage_Click" HorizontalAlignment="Stretch" />
                                <Button Grid.Row="0" Grid.Column="1" Content="العربية (RTL)" Tag="ar" Click="OnboardingLanguage_Click" HorizontalAlignment="Stretch" />
                                <Button Grid.Row="0" Grid.Column="2" Content="Français" Tag="fr" Click="OnboardingLanguage_Click" HorizontalAlignment="Stretch" />
                                <Button Grid.Row="1" Grid.Column="0" Content="Español" Tag="es" Click="OnboardingLanguage_Click" HorizontalAlignment="Stretch" />
                                <Button Grid.Row="1" Grid.Column="1" Content="Deutsch" Tag="de" Click="OnboardingLanguage_Click" HorizontalAlignment="Stretch" />
                                <Button Grid.Row="1" Grid.Column="2" Content="Türkçe" Tag="tr" Click="OnboardingLanguage_Click" HorizontalAlignment="Stretch" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Step 2: Recommended Real-Time Shields -->
                    <Border x:Name="OnboardingStep2" Visibility="Collapsed" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource GlowBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Step 2 of 3 — Activate Recommended Active Defense Shields" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <CheckBox x:Name="ObYaraGuardCheck" Content="Real-Time YARA Folder Guard (Downloads, Desktop, Temp, Startup)" IsChecked="True" />
                            <CheckBox x:Name="ObCanaryCheck" Content="Ransomware Canary Honeypot Guard" IsChecked="True" />
                            <CheckBox x:Name="ObHostsGuardCheck" Content="Hosts File &amp; DNS Hijack Real-Time Guard" IsChecked="True" />
                            <CheckBox x:Name="ObTrayCheck" Content="Keep Active Shields Running in Windows System Tray on Close" IsChecked="True" />
                        </StackPanel>
                    </Border>

                    <!-- Step 3: Ready to Launch -->
                    <Border x:Name="OnboardingStep3" Visibility="Collapsed" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource GlowBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Step 3 of 3 — You Are Protected &amp; Ready" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}" />
                            <TextBlock Text="Your chosen shields have been configured. Press Ctrl+K at any time to open the instant Command Palette, or launch your first Windows Hardening &amp; Global Threat Feed audit now." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Skip Setup" Click="OnboardingSkip_Click" HorizontalAlignment="Left" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="OnboardingBackBtn" Content="Back" Click="OnboardingBack_Click" Visibility="Collapsed" />
                            <Button x:Name="OnboardingNextBtn" Content="Next Step" Style="{StaticResource PrimaryButtonStyle}" Click="OnboardingNext_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>

</Window>
