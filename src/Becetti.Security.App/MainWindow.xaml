<Window
    x:Class="Becetti.Security.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="BECETTI SECURITY">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView
            x:Name="NavView"
            Grid.Row="0"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneOpen="True"
            Background="{StaticResource AppBackgroundBrush}">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavDashboard" Content="Dashboard" Tag="Dashboard" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavScan" Content="Smart Scan" Tag="Scan">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavProtection" Content="Real-Time Protection" Tag="Protection">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7EF;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavCloud" Content="Cloud Security" Tag="Cloud">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE753;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavAi" Content="BECETTI AI" Tag="Ai">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE99A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavRansomware" Content="Ransomware Defense" Tag="Ransomware">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA18;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavThreats" Content="Threat Management" Tag="Threats">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BA;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavPcHealth" Content="Smart PC Health" Tag="PcHealth">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavPrivacy" Content="Privacy &amp; Network" Tag="Privacy">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavHistory" Content="Security History" Tag="History">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavUpdates" Content="Updates" Tag="Updates">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE777;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavSettings" Content="Settings" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavContact" Content="Contact Becetti" Tag="Contact">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE715;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavAbout" Content="About BECETTI SECURITY" Tag="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.Header>
                <Grid Margin="16,12,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="Assets/Square150x150Logo.png" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Uid="AppHeaderTitle" Text="BECETTI SECURITY" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ElectricBlueBrush}" />
                        <TextBlock x:Uid="AppHeaderSubtitle" Text="Advanced Protection for Windows" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button x:Name="HelpButton" Style="{StaticResource HeaderIconButtonStyle}" Click="HelpButton_Click" ToolTipService.ToolTip="Help">
                            <FontIcon Glyph="&#xE897;" FontSize="16" />
                        </Button>
                        <Button x:Name="AboutButton" Style="{StaticResource HeaderIconButtonStyle}" Click="AboutButton_Click" ToolTipService.ToolTip="About">
                            <FontIcon Glyph="&#xE946;" FontSize="16" />
                        </Button>
                        <Button x:Name="SettingsButton" Style="{StaticResource HeaderIconButtonStyle}" Click="SettingsButton_Click" ToolTipService.ToolTip="Settings">
                            <FontIcon Glyph="&#xE713;" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Grid>
            </NavigationView.Header>
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- Footer status bar: real, verified readiness only — never decorative. -->
        <Border Grid.Row="1" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource GlowBorderBrush}" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="ReadinessDot" Grid.Column="0" Width="8" Height="8" Fill="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="FooterReadinessText" Grid.Column="1" Text="Checking readiness…" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock x:Name="FooterVersionText" Grid.Column="2" Text="BECETTI SECURITY v1.0.0.0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0" />
                <TextBlock x:Name="FooterCompatText" Grid.Column="3" Text="Windows 10 / 11 · x64" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!--
            Fixed, always-on-screen BECETTI AI launcher. Present on every page
            (it floats above the Grid, spanning both rows) so the assistant is
            never more than one tap away, per the product requirement that this
            must not be buried in a menu. Opens the full BECETTI AI chat page —
            never a small popup.
        -->
        <Button x:Name="AiLauncherButton"
                Grid.Row="0" Grid.RowSpan="2"
                Click="AiLauncherButton_Click"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,28,28"
                Width="64" Height="64"
                CornerRadius="32"
                Padding="0"
                Background="{StaticResource ElectricBlueBrush}"
                BorderThickness="0"
                ToolTipService.ToolTip="BECETTI AI">
            <Image Source="Assets/RobotMascotHero.png" Width="38" Height="38" Stretch="Uniform" />
        </Button>
    </Grid>

</Window>
