<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Becetti.Security.Core</RootNamespace>
    <AssemblyName>Becetti.Security.Core</AssemblyName>
    <Description>Shared security logic for BECETTI SECURITY: Microsoft Defender integration, system checks, cloud client, settings and event history. No simulated data: every result comes from a real Windows API, a real Defender interface, or a real HTTPS response.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- DPAPI token protection (Windows). Guarded at runtime; falls back to plain storage with an explicit warning on non-Windows hosts. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- Registry read access (Windows) for real OS/build info and UAC state. This project targets plain
         net8.0 (shared with the Api/Tests projects), so the registry types are not part of the default
         reference assemblies and must be added explicitly. All call sites are guarded with
         OperatingSystem.IsWindows() and throw PlatformNotSupportedException only on non-Windows hosts. -->
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <!-- Real essential-service status (Windows Defender, Firewall, Windows Update, BITS,
         Task Scheduler) for the PC Health page, via the official ServiceController API.
         Guarded at runtime with OperatingSystem.IsWindows(); this project targets plain
         net8.0 so the type is not part of the default reference assemblies. -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <!-- Real device driver inventory (Win32_PnPSignedDriver) for Driver Monitor, via the
         official WMI client API. Guarded with OperatingSystem.IsWindows(); this project
         targets plain net8.0 so the type is not part of the default reference assemblies. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Becetti.Security.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Single source of truth for UI strings across en-US, ar-SA, and fr-FR.
         Embedded directly in Core so LocalizationService resolves live language switches
         instantly without requiring an app restart or relying on UWP PrimaryLanguageOverride. -->
    <EmbeddedResource Include="..\Becetti.Security.App\Strings\en-US\Resources.resw" LogicalName="Becetti.Security.Core.Strings.en-US.resw" />
    <EmbeddedResource Include="..\Becetti.Security.App\Strings\ar-SA\Resources.resw" LogicalName="Becetti.Security.Core.Strings.ar-SA.resw" />
    <EmbeddedResource Include="..\Becetti.Security.App\Strings\fr-FR\Resources.resw" LogicalName="Becetti.Security.Core.Strings.fr-FR.resw" />
    <EmbeddedResource Include="..\Becetti.Security.App\Strings\es-ES\Resources.resw" LogicalName="Becetti.Security.Core.Strings.es-ES.resw" />
    <EmbeddedResource Include="..\Becetti.Security.App\Strings\de-DE\Resources.resw" LogicalName="Becetti.Security.Core.Strings.de-DE.resw" />
    <EmbeddedResource Include="..\Becetti.Security.App\Strings\tr-TR\Resources.resw" LogicalName="Becetti.Security.Core.Strings.tr-TR.resw" />
  </ItemGroup>

</Project>
